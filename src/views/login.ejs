<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Login - Controle de Maquininhas</title>
  <link rel="stylesheet" href="/css/style.css" />

  <script>
    (function () {
      try {
        var t = localStorage.getItem("theme");
        if (!t) t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.setAttribute("data-theme", t);
      } catch (e) {
        document.documentElement.setAttribute("data-theme", "light");
      }
    })();
  </script>

  <style>
    body {
      margin: 0;
      padding: 0;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      background: var(--bg);
      font-family: var(--font);
      color: var(--text);
    }

    /* ===== Card Principal ===== */
    .login-container {
      width: min(420px, 92vw);
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: 0 32px 34px;
      box-shadow: var(--shadow-lg);
      overflow: hidden;
      animation: fadeIn 0.4s ease;
    }

    /* ===== Área Superior / Logo (preto da marca) ===== */
    .top-box {
      width: calc(100% + 64px);
      margin-left: -32px;
      background: var(--ink);
      padding: 34px 0 26px;
      text-align: center;
    }

    .logo-ingresse { height: 46px; width: auto; display: block; margin: 0 auto; }

    /* ===== Títulos ===== */
    .login-title {
      text-align: center;
      font-size: 20px;
      font-weight: 700;
      margin-top: 20px;
      color: var(--text);
    }

    .login-subtitle {
      text-align: center;
      font-size: 13px;
      margin-bottom: 24px;
      color: var(--muted);
    }

    /* ===== Inputs ===== */
    .form-control {
      width: 100%;
      padding: 12px 14px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: var(--surface-2);
      color: var(--text);
      margin-top: 12px;
      font-size: 14px;
      outline: none;
      transition: 0.2s;
    }
    .form-control::placeholder { color: var(--muted); }

    .form-control:focus {
      border-color: var(--brand);
      box-shadow: 0 0 0 3px rgba(255, 39, 26, 0.15);
    }

    /* ===== Botão (Blood Orange) ===== */
    .btn-login {
      width: 100%;
      margin-top: 22px;
      padding: 13px;
      background: var(--brand);
      border: none;
      border-radius: 10px;
      color: #fff;
      font-weight: 600;
      font-size: 15px;
      cursor: pointer;
      transition: 0.2s;
    }

    .btn-login:hover {
      background: var(--brand-hover);
      transform: translateY(-1px);
      box-shadow: 0 4px 12px rgba(255, 39, 26, 0.3);
    }

    /* ===== Animação ===== */
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to   { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>

<body>

  <div class="login-container">

    <!-- TOPO -->
    <div class="top-box">
      <img src="/img/logo-ingresse-novo.png" class="logo-ingresse" alt="Ingresse">
    </div>

    <!-- TÍTULOS -->
    <h2 class="login-title">Controle de maquininhas</h2>
    <p class="login-subtitle">Sistema de Gestão de Equipamentos</p>

    <!-- FORM -->
    <form action="/login" method="POST">
      <input
        type="email"
        name="email"
        class="form-control"
        placeholder="Email"
        required
      />

      <input
        type="password"
        name="senha"
        class="form-control"
        placeholder="Senha"
        required
      />

      <button class="btn-login">Entrar</button>
    </form>

  </div>

</body>
</html>
