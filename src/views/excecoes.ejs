<%- include('partials/header') %>
<%- include('partials/sidebar', { page: 'excecoes', user }) %>

<style>
  /* usa .field/.control/.tbl/.table-scroll/.alert/.empty do design system (Onda 0) */
  .exc-section { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-md); padding: var(--space-4); margin-bottom: var(--space-5); box-shadow: var(--shadow); }
  .exc-section h2 { font-size: var(--fs-lg); margin: 0 0 4px 0; }
  .exc-sub { color: var(--muted); font-size: var(--fs-sm); margin-bottom: var(--space-3); }
  .exc-count { color: var(--muted); font-weight: 600; font-size: var(--fs-sm); }

  /* form de ação: .field/.control em linha, botão alinhado embaixo */
  .exc-form { display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: flex-end; padding: var(--space-3); border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface-2); margin-bottom: var(--space-3); }
  .exc-form .field { flex: 1 1 150px; min-width: 130px; }
  .exc-form .btn { flex: 0 0 auto; }

  /* tabelas: .tbl da fundação; scroll interno menor (listas curtas) */
  .exc-section .table-scroll { max-height: 340px; }
  .exc-section .tbl { min-width: 620px; }

  /* MOBILE (<=720): as tabelas viram CARDS (rótulo:valor), igual Máquinas/Histórico */
  @media (max-width: 720px) {
    .exc-section .table-scroll { max-height: none; overflow: visible; border: 0; }
    .exc-section .tbl { min-width: 0; }
    .exc-section .tbl thead { display: none; }
    .exc-section .tbl, .exc-section .tbl tbody { display: block; }
    .exc-section .tbl tbody tr { display: block; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: var(--space-2) var(--space-3); margin-bottom: var(--space-2); }
    .exc-section .tbl tbody tr:nth-child(odd) td, .exc-section .tbl tbody tr:hover td { background: transparent; }
    .exc-section .tbl tbody td { display: flex; justify-content: space-between; align-items: flex-start; gap: var(--space-3); padding: 4px 0; border: none; white-space: normal; overflow: visible; text-overflow: clip; }
    .exc-section .tbl tbody td::before { content: attr(data-label); flex: 0 0 auto; font-weight: 600; font-size: var(--fs-xs); color: var(--muted); text-transform: uppercase; letter-spacing: .03em; }
    .exc-section .tbl tbody td.empty { display: block; text-align: center; }
    .exc-section .tbl tbody td.empty::before { display: none; }
  }
</style>

<div class="main-content">
  <% if (typeof erro !== "undefined" && erro) { %>
    <div class="alert alert--danger">
      Não foi possível carregar as exceções agora — a planilha está indisponível. Recarregue em instantes.
    </div>
  <% } %>

  <% if (!excecoesAtivas) { %>
    <div class="alert alert--warn">
      Modo somente leitura — as ações estão desativadas. Ligue <code>EXCECOES_ATIVAS=1</code> na Vercel para habilitar o registro.
    </div>
  <% } %>

  <!-- ============ PERDIDAS ============ -->
  <div class="exc-section">
    <h2>Perdidas <span class="exc-count">(<%= perdidas.length %>)</span></h2>
    <div class="exc-sub">Registrar máquina perdida grava em PERDIDAS e tira das contagens (status "Perdida").</div>

    <form class="exc-form" data-acao="perdida">
      <div class="field"><label>Serial</label><input class="control" name="serial" placeholder="Ex: PBA12345" required></div>
      <div class="field"><label>Responsável</label><input class="control" name="responsavel" placeholder="Ex: Fred"></div>
      <div class="field" style="flex:2 1 220px"><label>Observação</label><input class="control" name="observacao" placeholder="Opcional"></div>
      <button type="submit" class="btn btn-primary" <%= excecoesAtivas ? '' : 'disabled' %>>Marcar como perdida</button>
    </form>

    <div class="table-scroll">
      <table class="tbl">
        <thead><tr><th>Serial</th><th>Status</th><th>Responsável</th><th>Evento</th><th>Obs</th></tr></thead>
        <tbody>
          <% perdidas.forEach(p => { %>
            <tr>
              <td data-label="Serial"><%= p.serial %></td><td data-label="Status"><%= p.status %></td><td data-label="Responsável"><%= p.responsavel %></td>
              <td data-label="Evento"><%= p.idEvento %><%= p.nomeEvento && p.nomeEvento !== '-' ? ' — ' + p.nomeEvento : '' %></td>
              <td data-label="Obs"><%= p.observacao %></td>
            </tr>
          <% }) %>
          <% if (perdidas.length === 0) { %><tr><td colspan="5" class="empty">Nenhuma máquina perdida registrada.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- ============ TROCAS ============ -->
  <div class="exc-section">
    <h2>Trocas <span class="exc-count">(<%= trocas.length %>)</span></h2>
    <div class="exc-sub">Relaciona a máquina com defeito à substituta. A defeituosa sai das contagens (status "Defeito").</div>

    <form class="exc-form" data-acao="troca">
      <div class="field"><label>Com defeito</label><input class="control" name="serialDefeito" placeholder="Serial defeituoso" required></div>
      <div class="field"><label>Problema</label><input class="control" name="problema" placeholder="Ex: Sem internet"></div>
      <div class="field"><label>Local</label><input class="control" name="local" placeholder="Ex: Estoque RJ"></div>
      <div class="field"><label>Nova (substituta)</label><input class="control" name="serialNova" placeholder="Serial novo (opcional)"></div>
      <button type="submit" class="btn btn-primary" <%= excecoesAtivas ? '' : 'disabled' %>>Registrar troca</button>
    </form>

    <div class="table-scroll">
      <table class="tbl">
        <thead><tr><th>Com defeito</th><th>Problema</th><th>Local</th><th>Nova</th></tr></thead>
        <tbody>
          <% trocas.forEach(t => { %>
            <tr><td data-label="Com defeito"><%= t.defeito %></td><td data-label="Problema"><%= t.problema %></td><td data-label="Local"><%= t.local %></td><td data-label="Nova"><%= t.nova %></td></tr>
          <% }) %>
          <% if (trocas.length === 0) { %><tr><td colspan="4" class="empty">Nenhuma troca registrada.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- ============ LOCALIZAR ============ -->
  <div class="exc-section">
    <h2>A localizar <span class="exc-count">(<%= localizar.length %>)</span></h2>
    <div class="exc-sub">Máquinas que precisam ser localizadas. Marca o status "Localizar" na CONTROLE.</div>

    <form class="exc-form" data-acao="localizar">
      <div class="field"><label>Serial</label><input class="control" name="serial" placeholder="Ex: PBA12345" required></div>
      <div class="field" style="flex:2 1 260px"><label>Referência (onde deveria estar)</label><input class="control" name="referencia" placeholder="Ex: era pra estar no Estoque SP"></div>
      <button type="submit" class="btn btn-primary" <%= excecoesAtivas ? '' : 'disabled' %>>Enviar para localizar</button>
    </form>

    <div class="table-scroll">
      <table class="tbl">
        <thead><tr><th>Serial</th><th>Modelo</th><th>Referência</th></tr></thead>
        <tbody>
          <% localizar.forEach(l => { %>
            <tr><td data-label="Serial"><%= l.serial %></td><td data-label="Modelo"><%= l.modelo %></td><td data-label="Referência"><%= l.referencia %></td></tr>
          <% }) %>
          <% if (localizar.length === 0) { %><tr><td colspan="3" class="empty">Nenhuma máquina a localizar.</td></tr><% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  // rotas por ação
  const ROTA = { perdida: "/api/perdida", troca: "/api/troca", localizar: "/api/localizar" };

  document.querySelectorAll("form.exc-form").forEach(form => {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const acao = form.dataset.acao;
      const btn = form.querySelector("button[type=submit]");
      const payload = {};
      form.querySelectorAll("input[name]").forEach(i => { payload[i.name] = i.value.trim(); });

      btn.disabled = true;
      try {
        const r = await fetch(ROTA[acao], {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload)
        });
        const data = await r.json();
        if (data.ok) {
          showToast("Registrado");
          setTimeout(() => location.reload(), 900);
        } else {
          showToast(data.msg || "Não foi possível registrar.", "err");
          btn.disabled = false;
        }
      } catch (err) {
        showToast("Erro de rede.", "err");
        btn.disabled = false;
      }
    });
  });
</script>

<%- include('partials/footer') %>
