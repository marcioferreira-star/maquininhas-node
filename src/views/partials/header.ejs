<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>Maquininhas</title>

  <link rel="stylesheet" href="/css/style.css" />

  <style>
    * { box-sizing: border-box; }

    /* ✅ Evita “corte”/overflow geral */
    html, body{
      width: 100%;
      max-width: 100%;
      overflow-x: hidden;
    }

    body {
      margin: 0;
      font-family: var(--font);
      background: var(--bg);
      color: var(--text);
    }

    /* =========================
       LAYOUT BASE (DESKTOP)
    ========================== */
    .app-shell{
      min-height: 100vh;
      display: flex;
      width: 100%;
      max-width: 100%;
      overflow-x: hidden;
    }

    /* sidebar (desktop) */
    .sidebar{
      width: 220px;
      flex: 0 0 220px;
      min-height: 100vh;
    }

    /* área direita (header + conteúdo) */
    .app-main{
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
      max-width: 100%;
    }

    /* header topo */
    .top-header{
      height: 60px;
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      padding: 0 16px;
      gap: 12px;
      min-width: 0;
    }

    .btn-menu{
      display: none;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text);
      border-radius: 10px;
      padding: 8px 10px;
      line-height: 1;
      cursor: pointer;
    }

    /* botão de alternar tema (claro/escuro) */
    .theme-toggle{
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--muted);
      border-radius: 999px;
      width: 38px;
      height: 38px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      flex: 0 0 auto;
      transition: color .18s, border-color .18s;
    }
    .theme-toggle:hover{ color: var(--brand); border-color: var(--brand); }
    .theme-toggle svg{ width: 20px; height: 20px; }
    /* mostra o ícone certo por tema */
    .theme-toggle .ic-moon{ display: inline-flex; }
    .theme-toggle .ic-sun{ display: none; }
    :root[data-theme="dark"] .theme-toggle .ic-moon{ display: none; }
    :root[data-theme="dark"] .theme-toggle .ic-sun{ display: inline-flex; }

    .top-header-right{
      margin-left: auto;
      display: flex;
      align-items: center;
      gap: 14px;
      min-width: 0;
    }

    .user-info{
      display: inline-flex;
      align-items: center;
      gap: 7px;
      font-size: 15px;
      font-weight: 600;
      color: var(--text);
      white-space: nowrap;
      max-width: 45vw;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .user-info svg{ width: 18px; height: 18px; color: var(--muted); flex: 0 0 auto; }

    .logout-btn{
      background: var(--danger);
      padding: 8px 14px;
      border-radius: 8px;
      color: #fff !important;
      font-weight: 700;
      text-decoration: none;
      transition: background .2s;
      white-space: nowrap;
      flex: 0 0 auto;
    }
    .logout-btn:hover{ background: var(--danger-hover); }

    /* overlay (mobile) */
    .overlay{
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.35);
      z-index: 998;
    }
    .overlay.show{ display: block; }

    /* =========================
       ✅ MOBILE
    ========================== */
    @media (max-width: 1200px){
      .app-shell{ display: block; }

      .btn-menu{ display: inline-flex; align-items:center; justify-content:center; }

      /* sidebar vira drawer */
      .sidebar{
        position: fixed;
        top: 0;
        left: 0;
        height: 100vh;
        width: 84vw;
        max-width: 320px;
        transform: translateX(-100%);
        transition: transform .2s ease;
        z-index: 999;
        overflow-y: auto;
      }
      .sidebar.open{ transform: translateX(0); }
    }
  </style>

  <!-- aplica o tema ANTES do paint (evita flash); fonte: localStorage ou preferência do SO -->
  <script>
    (function () {
      try {
        var t = localStorage.getItem("theme");
        if (!t) t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.setAttribute("data-theme", t);
      } catch (e) {
        document.documentElement.setAttribute("data-theme", "light");
      }
    })();
  </script>
</head>

<body>

<div class="overlay" id="overlay" onclick="closeMenu()"></div>

<div class="app-shell">
