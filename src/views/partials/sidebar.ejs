<%
  // título da aba exibido na top-header (deriva de `page` — sem tocar nas rotas)
  const titulosPagina = {
    dashboard: 'Dashboard',
    maquinas: 'Máquinas Cadastradas',
    envio: 'Envio / Retorno',
    historico: 'Histórico de Movimentações',
    excecoes: 'Exceções'
  };
%>
<div class="sidebar" id="sidebar">
  <div class="logo">
    <img src="/img/logo-ingresse-novo.png" alt="Ingresse" />
    <span class="logo-name">Maquininhas</span>
  </div>

  <ul>
    <li class="<%= page === 'dashboard' ? 'active' : '' %>">
      <a href="/">
        <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="6" height="7" rx="1"/><rect x="4" y="15" width="6" height="5" rx="1"/><rect x="14" y="4" width="6" height="5" rx="1"/><rect x="14" y="13" width="6" height="7" rx="1"/></svg>
        Dashboard
      </a>
    </li>

    <li class="<%= page === 'maquinas' ? 'active' : '' %>">
      <a href="/maquinas">
        <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="3"/><line x1="3" y1="10" x2="21" y2="10"/><line x1="7" y1="15" x2="9" y2="15"/></svg>
        Máquinas Cadastradas
      </a>
    </li>

    <li class="<%= page === 'envio' ? 'active' : '' %>">
      <a href="/envio">
        <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 11H7l4-4"/><path d="M4 13h13l-4 4"/></svg>
        Envio / Retorno
      </a>
    </li>

    <li class="<%= page === 'historico' ? 'active' : '' %>">
      <a href="/historico">
        <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v4l3 2"/><path d="M3.05 11a9 9 0 1 1 .5 4"/><path d="M3 4v5h5"/></svg>
        Histórico
      </a>
    </li>

    <li class="<%= page === 'excecoes' ? 'active' : '' %>">
      <a href="/excecoes">
        <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4"/><path d="M12 17h.01"/><path d="M10.3 4.3l-8 14A1.9 1.9 0 0 0 4 21h16a1.9 1.9 0 0 0 1.7-2.7l-8-14a1.9 1.9 0 0 0-3.4 0z"/></svg>
        Exceções
      </a>
    </li>
  </ul>

  <!-- Sincronização manual planilha → espelho Neon (qualquer operador logado) -->
  <div class="sidebar-sync">
    <button type="button" class="btn-sync" id="btnSync" title="Atualizar o espelho (planilha → Neon)">
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 11a8 8 0 1 0-2.3 5.7"/><path d="M20 5v6h-6"/></svg>
      Sincronizar
    </button>
    <span class="sync-status" id="syncStatus">Última: —</span>
  </div>
</div>

<div class="app-main">
  <div class="top-header">
    <button class="btn-menu" onclick="toggleMenu()" aria-label="Abrir menu">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>
    </button>

    <h1 class="page-title"><%= titulosPagina[page] || 'Maquininhas' %></h1>

    <div class="top-header-right">
      <div class="user-info">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M5 21v-1a5 5 0 0 1 5-5h4a5 5 0 0 1 5 5v1"/></svg>
        <%= (user && user.nome) ? user.nome : "Usuário" %>
      </div>

      <button class="theme-toggle" onclick="toggleTheme()" aria-label="Alternar tema claro/escuro" title="Alternar tema">
        <span class="ic-moon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9a9 9 0 1 1 -9 -9z"/></svg></span>
        <span class="ic-sun"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></span>
      </button>

      <a href="/logout" class="btn btn-danger btn-sm">Sair</a>
    </div>
  </div>
