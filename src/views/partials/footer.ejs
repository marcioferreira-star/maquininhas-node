</div> <!-- app-main -->
</div> <!-- app-shell -->

<script>
  function openMenu(){
    var sidebar = document.getElementById('sidebar');
    var overlay = document.getElementById('overlay');
    if (sidebar) sidebar.classList.add('open');
    if (overlay) overlay.classList.add('show');
  }

  function closeMenu(){
    var sidebar = document.getElementById('sidebar');
    var overlay = document.getElementById('overlay');
    if (sidebar) sidebar.classList.remove('open');
    if (overlay) overlay.classList.remove('show');
  }

  function toggleMenu(){
    var sidebar = document.getElementById('sidebar');
    if (!sidebar) return;
    if (sidebar.classList.contains('open')) closeMenu();
    else openMenu();
  }

  // alterna tema claro/escuro e persiste no localStorage
  function toggleTheme(){
    var atual = document.documentElement.getAttribute('data-theme') || 'light';
    var novo = atual === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', novo);
    try { localStorage.setItem('theme', novo); } catch(e){}
  }

  // toast não-bloqueante: showToast("mensagem", "ok"|"err")
  function showToast(msg, tipo){
    var area = document.getElementById('toastArea');
    if (!area) return;
    var t = document.createElement('div');
    t.className = 'toast ' + (tipo === 'err' ? 'err' : 'ok');
    t.setAttribute('role', 'status');
    t.textContent = msg;
    area.appendChild(t);
    requestAnimationFrame(function(){ t.classList.add('show'); });
    setTimeout(function(){
      t.classList.remove('show');
      setTimeout(function(){ t.remove(); }, 250);
    }, 2600);
  }

  // uiConfirm(msg) → Promise<boolean> e uiPrompt(msg, valor) → Promise<string|null>.
  // Modal sobre <dialog> nativo (fallback pro confirm/prompt nativo se indisponível).
  function _uiDialog(opts){
    return new Promise(function(resolve){
      if (!window.HTMLDialogElement){
        resolve(opts.prompt ? window.prompt(opts.msg, opts.value || '') : window.confirm(opts.msg));
        return;
      }
      var dlg = document.createElement('dialog');
      dlg.className = 'dialog';
      dlg.innerHTML =
        '<form method="dialog" class="dialog__body">' +
          '<div class="dialog__msg"></div>' +
          (opts.prompt ? '<input class="control" id="_uiIn" autocomplete="off" />' : '') +
          '<div class="dialog__foot">' +
            '<button class="btn btn-secondary btn-sm" value="cancel"></button>' +
            '<button class="btn btn-primary btn-sm" value="ok"></button>' +
          '</div>' +
        '</form>';
      dlg.querySelector('.dialog__msg').textContent = opts.msg;
      dlg.querySelector('button[value="cancel"]').textContent = 'Cancelar';
      dlg.querySelector('button[value="ok"]').textContent = opts.ok || 'OK';
      var inEl = dlg.querySelector('#_uiIn');
      if (inEl && opts.value) inEl.value = opts.value;
      document.body.appendChild(dlg);
      dlg.addEventListener('close', function(){
        var okr = dlg.returnValue === 'ok';
        var val = inEl ? inEl.value : null;
        dlg.remove();
        resolve(opts.prompt ? (okr ? val : null) : okr);
      });
      dlg.showModal();
      if (inEl) inEl.focus();
    });
  }
  function uiConfirm(msg, okLabel){ return _uiDialog({ msg: msg, ok: okLabel }); }
  function uiPrompt(msg, value, okLabel){ return _uiDialog({ msg: msg, value: value, ok: okLabel, prompt: true }); }

  // Sincronização manual (planilha → espelho Neon) — botão no rodapé da sidebar.
  // Global (a sidebar está em todas as telas).
  (function syncUI(){
    var btn = document.getElementById('btnSync');
    var stat = document.getElementById('syncStatus');
    if (!btn || !stat) return;

    // timestamp completo (ISO com fuso) → BRT. new Date(ISO-completo) é seguro
    // (o bug UTC só afeta strings de data pura "aaaa-mm-dd").
    function fmtBRT(iso){
      if (!iso) return '—';
      try {
        return new Date(iso).toLocaleString('pt-BR', { timeZone:'America/Sao_Paulo', day:'2-digit', month:'2-digit', hour:'2-digit', minute:'2-digit' });
      } catch(e){ return '—'; }
    }
    function pinta(u){
      if (!u) { stat.textContent = 'Última: nunca'; return; }
      stat.textContent = u.ok ? ('Última: ' + fmtBRT(u.executado_em)) : ('Última: ' + fmtBRT(u.executado_em) + ' (falhou)');
    }
    function carregar(){
      fetch('/api/sync-status').then(function(r){ return r.json(); })
        .then(function(d){ pinta(d.ultimo); })
        .catch(function(){ stat.textContent = 'Última: —'; });
    }
    carregar();

    btn.addEventListener('click', function(){
      btn.disabled = true;
      stat.textContent = 'Sincronizando…';
      fetch('/api/sync-manual', { method:'POST', headers:{ 'Content-Type':'application/json' } })
        .then(function(r){ return r.json().then(function(d){ return { status:r.status, d:d }; }); })
        .then(function(res){
          if (res.status === 409) showToast(res.d.msg || 'Já há uma sincronização em andamento.', 'err');
          else if (res.d.ok) showToast('Sincronizado: ' + res.d.maquina + ' máquinas em ' + (res.d.ms/1000).toFixed(1) + 's');
          else showToast(res.d.msg || 'Falha ao sincronizar.', 'err');
        })
        .catch(function(){ showToast('Erro de rede ao sincronizar.', 'err'); })
        .then(function(){ btn.disabled = false; carregar(); });
    });
  })();
</script>

<div id="toastArea"></div>

<footer style="text-align:center; padding:18px 0; color:var(--muted); font-size:14px; border-top:1px solid var(--border);">
  © <%= new Date().getFullYear() %> Ingresse. Todos os direitos reservados.
</footer>

</body>
</html>
