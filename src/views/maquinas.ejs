<%- include('partials/header') %>
<%- include('partials/sidebar', { page, user }) %>

<style>
  .filters-box {
    display: flex;
    gap: 12px;
    margin-bottom: 20px;
  }

  .filters-box input,
  .filters-box select {
    height: 38px;
    padding-left: 10px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    flex: 1;
  }

  .btn-limpar, .btn-exportar {
    height: 38px;
    padding: 0 18px;
    border-radius: 8px;
    cursor: pointer;
    white-space: nowrap;
    font-weight: 600;
  }

  .btn-limpar { background: transparent; color: var(--text); border: 1px solid var(--border); }
  .btn-limpar:hover { background: var(--surface-2); }
  .btn-exportar { background: var(--brand); color: #fff; border: none; }
  .btn-exportar:hover { background: var(--brand-hover); }

  #contador {
    font-size: 15px;
    font-weight: bold;
    margin-bottom: 8px;
    color: var(--text);
  }

  .table-wrapper {
    max-height: 68vh;
    overflow-y: auto;
    overflow-x: auto;                /* ✅ scroll horizontal */
    -webkit-overflow-scrolling: touch;
    border-radius: 10px;
    border: 1px solid var(--border);
  }

  table {
    width: 100%;
    min-width: 1080px;               /* ✅ evita esmagar colunas (Situação + Nome Evento) */
    border-collapse: collapse;
    background: var(--surface);
  }

  /* Pills de Situação (coluna que veio do Histórico) */
  .pill-sit {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 600;
    line-height: 1.3;
    color: #fff;
    white-space: nowrap;
  }
  .pill-sit.atrasado   { background: #d9534f; }
  .pill-sit.vence      { background: #e0a800; color: #1A1A1A; }
  .pill-sit.noprazo    { background: #28a745; }
  .pill-sit.disponivel { background: #5a87c9; }
  .pill-sit.fixo       { background: #6c757d; }
  .pill-sit.semdata    { background: #6c757d; }

  thead th {
    position: sticky;
    top: 0;
    background: var(--table-head-bg);
    color: var(--table-head-fg);
    padding: 10px;
    font-size: 14px;
    z-index: 5;
    white-space: nowrap;             /* ✅ não quebra letra por letra */
  }

  tbody td {
    padding: 10px;
    background: var(--surface);
    color: var(--text);
    border-bottom: 1px solid var(--border);
    white-space: nowrap;             /* ✅ não quebra letra por letra */
  }

  /* linhas alternadas + hover (igual à tabela de Histórico) */
  tbody tr:nth-child(odd) td { background: var(--surface-2); }
  tbody tr:hover td          { background: var(--surface-3); }

  .btn-salvar {
    background: var(--brand);
    border: none;
    padding: 6px 14px;
    color: #fff;
    border-radius: 8px;
    cursor: pointer;
    font-weight: 600;
  }
  .btn-salvar:hover { background: var(--brand-hover); }

  /* ✅ MOBILE: filtros quebram linha */
  @media (max-width: 900px){
    .filters-box{
      flex-wrap: wrap;
    }
    .filters-box input,
    .filters-box select{
      flex: 1 1 48%;
      min-width: 160px;
    }
    .btn-limpar, .btn-exportar{
      flex: 1 1 48%;
    }
  }
</style>

<div class="main-content">
  <h1>Máquinas Cadastradas</h1>

  <% if (typeof erro !== "undefined" && erro) { %>
    <div style="background:#f8ebe9;border:1px solid #d9534f;color:#a12a22;padding:12px 16px;border-radius:8px;margin-bottom:16px;font-weight:600;">
      Não foi possível carregar as máquinas agora — a planilha está indisponível. Recarregue em instantes.
    </div>
  <% } %>

  <div id="contador">Exibindo 0 máquinas</div>

  <!-- ===================== FILTROS ===================== -->
  <div class="filters-box">

    <input type="text" id="filtroSerial" placeholder="Serials (ex: PBA123,11703)">

    <select id="filtroStatus" data-label="Status">
      <option value="">Status</option>
    </select>

    <select id="filtroSituacao" data-label="Situação">
      <option value="">Situação</option>
    </select>

    <select id="filtroEmpresa" data-label="Empresa">
      <option value="">Empresa</option>
    </select>

    <input type="text" id="filtroEvento" placeholder="Evento (ID ou nome)">

    <select id="filtroRetorno" data-label="Retorno">
      <option value="">Retorno</option>
      <option value="hoje">Hoje</option>
      <option value="semana">Esta Semana</option>
      <option value="mes">Este Mês</option>
      <option value="atrasada">Atrasadas</option>
      <option value="emdia">Em Dia</option>
    </select>

    <button class="btn-limpar" id="btnLimpar">Limpar</button>
    <button class="btn-exportar" id="btnExportar">Exportar Excel</button>
  </div>

  <!-- ===================== TABELA ===================== -->
  <div class="table-wrapper">
    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>Modelo</th>
          <th>Nº Serial</th>
          <th>Status</th>
          <th>Situação</th>
          <th>Empresa</th>
          <th>ID Evento</th>
          <th>Nome Evento</th>
          <th>Data Retorno</th>
          <th>Obs</th>
          <th>Ação</th>
        </tr>
      </thead>

      <tbody id="listaMaquinas">
        <% maquinas.forEach((m, i) => { %>

        <tr 
          class="linha"
          data-serial="<%= (m.serial || '').toLowerCase() %>"
          data-status="<%= (m.status || '-').trim() %>"
          data-empresa="<%= (m.empresa || '-').trim() %>"
          data-evento="<%= (m.idEvento || '').trim() %>"
          data-nomeevento="<%= (m.nomeEvento || '-') %>"
          data-produtora="<%= (m.produtora || '-') %>"
          data-comercial="<%= (m.comercial || '-') %>"
          data-retorno="<%= (m.status.startsWith('Em Uso') || m.status === 'Fixo') ? (m.dataRetorno || '-') : '-' %>"
          data-processando="<%= (m.processando || '-').trim() %>"
          data-situacao="<%= m.situacao || '' %>"
        >
          <td><%= i + 1 %></td>
          <td><%= m.modelo || '-' %></td>
          <td><%= m.serial || '-' %></td>

          <td>
            <select class="select-status" id="status_<%= m.linha %>">
              <% const sts = ["Estoque SP","Estoque RJ","Estoque URA","Em Uso SP","Em Uso RJ","Em Uso URA","Fixo"]; %>
              <% sts.forEach(s => { %>
                <option value="<%= s %>" <%= (m.status === s ? "selected" : "") %>><%= s %></option>
              <% }) %>
            </select>
          </td>

          <!-- ✅ Situação (derivada do status; veio do Histórico) -->
          <td>
            <% const _sitCls = { "Atrasado":"atrasado","Vence hoje":"vence","Dentro do prazo":"noprazo","Disponível":"disponivel","Fixo":"fixo","Sem data":"semdata" }[m.situacao] || ""; %>
            <% if (m.situacao) { %><span class="pill-sit <%= _sitCls %>"><%= m.situacao %></span><% } else { %>-<% } %>
          </td>

          <td><%= m.empresa || '-' %></td>

          <!-- ✅ Fixo também mostra evento -->
          <td><%= (m.status.startsWith("Em Uso") || m.status === "Fixo") ? (m.idEvento || '-') : "-" %></td>

          <!-- ✅ Nome do evento (ao lado do ID) — trunca + tooltip com nome completo -->
          <% const _nomeEv = (m.status.startsWith("Em Uso") || m.status === "Fixo") ? (m.nomeEvento || '-') : "-"; %>
          <td title="<%= _nomeEv !== '-' ? _nomeEv : '' %>">
            <span style="display:inline-block;max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;vertical-align:middle;"><%= _nomeEv %></span>
          </td>

          <!-- ✅ Fixo também mostra retorno (vai ser "-") -->
          <td><%= (m.status.startsWith("Em Uso") || m.status === "Fixo") ? (m.dataRetorno || '-') : "-" %></td>

          <!-- OBSERVAÇÃO (col P) + Operadora/Chip no tooltip + badge "Processando" -->
          <% const _obs = (m.observacao && m.observacao !== '-') ? m.observacao : ''; %>
          <% const _tip = [ (m.operadora && m.operadora !== '-') ? ('Operadora: ' + m.operadora) : '', (m.infoChip && m.infoChip !== '-') ? ('Chip: ' + m.infoChip) : '', _obs ? ('Obs: ' + _obs) : '' ].filter(Boolean).join('  |  '); %>
          <td class="obs-cell" title="<%= _tip %>">
            <span style="display:inline-block;max-width:170px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;vertical-align:middle;"><%= _obs %></span>
          </td>

          <td>
            <button
              class="btn-salvar"
              data-serial="<%= m.serial %>"
              data-select="status_<%= m.linha %>"
            >
              Salvar
            </button>
          </td>
        </tr>

        <% }) %>

        <tr id="emptyRow" class="empty-row" style="<%= maquinas.length === 0 ? '' : 'display:none' %>">
          <td colspan="11">Nenhuma máquina encontrada para os filtros aplicados.</td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

<script>
/* ============================================================
      VARIÁVEIS
============================================================ */
const linhas = [...document.querySelectorAll(".linha")];
const filtroSerial   = document.getElementById("filtroSerial");
const filtroStatus   = document.getElementById("filtroStatus");
const filtroSituacao = document.getElementById("filtroSituacao");
const filtroEmpresa  = document.getElementById("filtroEmpresa");
const filtroEvento   = document.getElementById("filtroEvento");
const filtroRetorno  = document.getElementById("filtroRetorno");
const btnLimpar     = document.getElementById("btnLimpar");
const btnExportar   = document.getElementById("btnExportar");
const contador      = document.getElementById("contador");

/* ============================================================
      SITUAÇÃO (client) — usado no update in-place após Salvar.
      Espelha src/utils/datas.js:situacaoDeMaquina (a 1ª renderização
      vem do servidor, com fuso BRT correto).
============================================================ */
const SIT_CLS = {
  "Atrasado": "atrasado",
  "Vence hoje": "vence",
  "Dentro do prazo": "noprazo",
  "Disponível": "disponivel",
  "Fixo": "fixo",
  "Sem data": "semdata"
};
function situacaoClient(status, retornoBR) {
  const s = String(status || "").toLowerCase();
  if (s.startsWith("em uso")) {
    if (!retornoBR || retornoBR === "-") return "Sem data";
    const [dd, mm, yy] = String(retornoBR).split("/");
    const dt = new Date(Number(yy), Number(mm) - 1, Number(dd));
    if (isNaN(dt.getTime())) return "Sem data";
    const h = new Date();
    const hoje = new Date(h.getFullYear(), h.getMonth(), h.getDate());
    const diff = Math.round((dt - hoje) / 86400000);
    if (diff < 0) return "Atrasado";
    if (diff === 0) return "Vence hoje";
    return "Dentro do prazo";
  }
  if (s === "fixo") return "Fixo";
  if (s.startsWith("estoque")) return "Disponível";
  return "";
}

/* ============================================================
      FILTRO INICIAL (vindo do dashboard via querystring)
      ?f=<substring de status: estoque|em uso|fixo>  e/ou  ?retorno=<atrasada|...>
============================================================ */
const _params = new URLSearchParams(location.search);
let statusInicial = (_params.get("f") || "").toLowerCase().trim();

/* ============================================================
      FUNÇÃO CONTADOR
============================================================ */
function atualizarContador() {
  const vis = linhas.filter(l => l.style.display !== "none").length;
  contador.innerHTML = `Exibindo <b>${vis}</b> de <b>${linhas.length}</b> máquinas`;
  const empty = document.getElementById("emptyRow");
  if (empty) empty.style.display = (vis === 0) ? "" : "none";
}

/* ============================================================
      APLICAR FILTROS
============================================================ */
function aplicarFiltros() {
  const txt = filtroSerial.value.toLowerCase();
  const st  = filtroStatus.value;
  const sit = filtroSituacao.value;
  const emp = filtroEmpresa.value;
  const ev  = filtroEvento.value;
  const ret = filtroRetorno.value;

  const hoje = new Date();

  linhas.forEach(row => {
    let mostrar = true;

    const serial   = row.dataset.serial;
    const status   = row.dataset.status;
    const situacao = row.dataset.situacao;
    const empresa  = row.dataset.empresa;
    const evento   = row.dataset.evento;
    const nome     = row.dataset.nomeevento;
    const retorno  = row.dataset.retorno;

    /* ----- Serial (múltiplos) ----- */
    if (txt) {
      const termos = txt.split(",").map(t => t.trim()).filter(t => t);
      if (!termos.some(t => serial.includes(t))) mostrar = false;
    }

    if (st && status !== st) mostrar = false;
    if (sit && situacao !== sit) mostrar = false;
    // filtro inicial por substring de status (vindo do KPI do dashboard)
    if (statusInicial && !(status || "").toLowerCase().includes(statusInicial)) mostrar = false;
    if (emp && empresa !== emp) mostrar = false;
    /* ----- Evento (múltiplos): casa por ID exato OU por substring do nome ----- */
    if (ev) {
      const termosEv = String(ev)
        .split(",")
        .map(t => t.trim().toLowerCase())
        .filter(Boolean);

      const eventoStr = String(evento || "").trim().toLowerCase();
      const nomeStr   = String(nome || "").trim().toLowerCase();

      if (!termosEv.some(t => eventoStr === t || nomeStr.includes(t))) mostrar = false;
    }

    /* ----- Filtro de retorno (só faz sentido p/ máquina EM USO) ----- */
    if (ret) {
      if (!status.startsWith("Em Uso") || !retorno || retorno === "-") {
        mostrar = false;
      } else {
        // ✅ parse em horário LOCAL (não usar new Date("aaaa-mm-dd") → vira UTC e regride 1 dia)
        const [dd, mm, yy] = retorno.split("/");
        const dt = new Date(Number(yy), Number(mm) - 1, Number(dd));
        const hojeMid = new Date(hoje.getFullYear(), hoje.getMonth(), hoje.getDate());

        const diff = Math.round((dt - hojeMid) / 86400000);

        // ✅ atrasada só faz sentido pra Em Uso, não pra Fixo
        if (ret === "atrasada" && !(status.startsWith("Em Uso") && diff < 0))
          mostrar = false;

        if (ret === "emdia" && diff < 0) mostrar = false;

        if (ret === "hoje" && diff !== 0) mostrar = false;

        if (ret === "semana" && !(diff >= 0 && diff <= 7)) mostrar = false;

        if (ret === "mes" && dt.getMonth() !== hoje.getMonth())
          mostrar = false;
      }
    }

    row.style.display = mostrar ? "" : "none";
  });

  atualizarFiltrosInteligentes();
  atualizarContador();
}

/* ============================================================
      FILTROS INTELIGENTES
============================================================ */
function atualizarFiltro(select, values) {
  const label = select.dataset.label;
  const atual = select.value;

  select.innerHTML = `<option value="">${label}</option>`;
  values.forEach(v => {
    const op = document.createElement("option");
    op.value = v;
    op.textContent = v;
    select.appendChild(op);
  });

  if (values.includes(atual)) select.value = atual;
}

function atualizarFiltrosInteligentes() {
  const vis = linhas.filter(l => l.style.display !== "none");

  atualizarFiltro(filtroStatus,   [...new Set(vis.map(l => l.dataset.status))]);
  atualizarFiltro(filtroSituacao, [...new Set(vis.map(l => l.dataset.situacao))].filter(x => x && x !== "-"));
  atualizarFiltro(filtroEmpresa,  [...new Set(vis.map(l => l.dataset.empresa))]);
}

/* ============================================================
      EVENTOS FILTROS
============================================================ */
[filtroSerial, filtroStatus, filtroSituacao, filtroEmpresa, filtroEvento, filtroRetorno]
  .forEach(f => {
    f.addEventListener("input", aplicarFiltros);
    f.addEventListener("change", aplicarFiltros);
  });

/* ============================================================
      LIMPAR
============================================================ */
btnLimpar.addEventListener("click", () => {
  filtroSerial.value = "";
  filtroStatus.value = "";
  filtroSituacao.value = "";
  filtroEmpresa.value = "";
  filtroEvento.value = "";
  filtroRetorno.value = "";
  statusInicial = ""; // também limpa o filtro que veio do dashboard
  aplicarFiltros();
});

/* ============================================================
      APLICA O FILTRO INICIAL DA QUERYSTRING (se houver)
============================================================ */
if (_params.get("retorno")) filtroRetorno.value = _params.get("retorno");
if (statusInicial || _params.get("retorno")) aplicarFiltros();

/* ============================================================
      EXPORTAR
============================================================ */
btnExportar.addEventListener("click", () => {
  const vis = linhas.filter(l => l.style.display !== "none");
  if (vis.length === 0) return showToast("Nenhuma máquina filtrada.", "err");

  // usa dataset (não índice de coluna) → robusto a reordenação de colunas
  const dados = vis.map(l => ({
    Modelo:         l.children[1].innerText.trim(),
    Serial:         l.children[2].innerText.trim(),
    Status:         l.querySelector("select").value,
    "Situação":     l.dataset.situacao || "-",
    Empresa:        l.dataset.empresa,
    "ID Evento":    l.dataset.evento || "-",
    "Nome Evento":  l.dataset.nomeevento,
    Produtora:      l.dataset.produtora,
    Comercial:      l.dataset.comercial,
    "Data Retorno": l.dataset.retorno
  }));

  const ws = XLSX.utils.json_to_sheet(dados);
  const wb = XLSX.utils.book_new();
  XLSX.utils.book_append_sheet(wb, ws, "Máquinas");
  XLSX.writeFile(wb, "maquinas_filtradas.xlsx");
});

/* ============================================================
      SALVAR STATUS
============================================================ */
document.querySelectorAll(".btn-salvar").forEach(btn => {
  btn.addEventListener("click", async () => {
    const serial = btn.dataset.serial;
    const status = document.getElementById(btn.dataset.select).value;
    const row = btn.closest("tr");

    // avisa se a máquina está marcada como "Processando?" (col H)
    if (row && row.dataset.processando === "Sim") {
      if (!confirm("Esta máquina está marcada como 'Processando'. Alterar o status mesmo assim?")) return;
    }

    btn.disabled = true;
    try {
      const resp = await fetch("/api/atualizar-status", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ serial, status })
      });
      const data = await resp.json();

      if (data.ok) {
        showToast("Status atualizado");
        if (row) {
          // atualização in-place (preserva filtros/rolagem — sem location.reload)
          row.dataset.status = status;
          // reflete a limpeza de evento/retorno que o backend faz ao virar Estoque/Fixo
          if (status.startsWith("Estoque")) {
            row.children[6].textContent = "-"; // ID Evento
            row.children[7].textContent = "-"; // Nome Evento
            row.children[8].textContent = "-"; // Data Retorno
            row.dataset.evento = "";
            row.dataset.nomeevento = "-";
            row.dataset.retorno = "-";
          } else if (status === "Fixo") {
            row.children[8].textContent = "-"; // Data Retorno (Fixo não retorna)
            row.dataset.retorno = "-";
          }
          // recalcula a Situação (col 4) + dataset
          const novaSit = situacaoClient(status, row.dataset.retorno);
          row.dataset.situacao = novaSit;
          const celSit = row.children[4];
          celSit.innerHTML = "";
          if (novaSit) {
            const span = document.createElement("span");
            span.className = "pill-sit " + (SIT_CLS[novaSit] || "");
            span.textContent = novaSit;
            celSit.appendChild(span);
          } else {
            celSit.textContent = "-";
          }
          aplicarFiltros(); // a linha pode sair do filtro atual
        }
      } else {
        showToast(data.msg || "Erro ao atualizar", "err");
      }
    } catch (e) {
      showToast("Erro de rede ao salvar", "err");
    } finally {
      btn.disabled = false;
    }
  });
});

// contador + empty-state no load (antes só atualizava ao filtrar)
atualizarContador();

/* INIT */
atualizarFiltrosInteligentes();
atualizarContador();
</script>

<%- include('partials/footer') %>
