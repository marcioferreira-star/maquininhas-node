<%- include('partials/header') %>
<%- include('partials/sidebar', { page: 'envio', user }) %>

<style>
  /* usa .panel/.control/.btn/.field do design system (Onda 0) */
  .section-title { font-size: var(--fs-lg); font-weight: 700; margin-bottom: var(--space-2); }
  .area-flex { display: flex; gap: var(--space-4); width: 100%; align-items: stretch; }
  .area-flex > .panel { width: 100%; min-width: 0; }
  #buscaSerial { width: 100%; margin-bottom: var(--space-3); }
  .lista-maquinas { height: 350px; overflow-y: auto; }
  .item-maq {
    padding: var(--space-2) var(--space-3); border: 1px solid var(--border);
    border-radius: var(--radius-sm); margin-bottom: 6px; cursor: pointer;
    background: var(--surface-2); color: var(--text); font-size: var(--fs-md);
  }
  .item-maq.selecionada { background: var(--brand-soft); border-color: var(--brand); }
  .selecionadas-box { height: 350px; border: 1px dashed var(--border); background: var(--surface-2); border-radius: var(--radius-sm); padding: var(--space-2); overflow-y: auto; }
  #listaSelecionadas { margin: 0; padding: 0; }
  #listaSelecionadas li {
    list-style: none; display: flex; align-items: center; justify-content: space-between;
    gap: var(--space-2); padding: var(--space-2) var(--space-3); margin-bottom: var(--space-2);
    background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-sm); min-width: 0;
  }
  #listaSelecionadas li .sel-main { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 2px; }
  #listaSelecionadas li .serial-text { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; color: var(--text); }
  #listaSelecionadas li .sel-status { font-size: 12px; color: var(--muted); font-weight: 400; overflow-wrap: anywhere; }
  .campo { margin-bottom: var(--space-3); }
  .campo > label { font-weight: 600; display: block; margin-bottom: var(--space-1); font-size: var(--fs-md); }
  .campo .control, .campo textarea.control { width: 100%; }
  /* botão registrar (full-width, grande) — usa .btn .btn-primary */
  .btn-registrar { width: 100%; max-width: 600px; margin: var(--space-6) auto var(--space-8); font-size: var(--fs-lg); padding: 14px; }

  @media (max-width: 720px){
    .area-flex { flex-direction: column; }
    .lista-maquinas, .selecionadas-box { height: 280px; }
    .btn-registrar { max-width: 100%; }
  }
</style>

<div class="main-content">

  <div class="area-flex">

    <!-- LISTA -->
    <div class="panel">
      <div class="section-title" style="display:flex;align-items:center;justify-content:space-between;gap:8px;">
        <span>Máquinas (Serial + Status)</span>
        <button type="button" class="btn btn-secondary btn-sm" id="btnBipar" title="Ler o código de barras da máquina">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7V5a1 1 0 0 1 1-1h2"/><path d="M4 17v2a1 1 0 0 0 1 1h2"/><path d="M20 7V5a1 1 0 0 0-1-1h-2"/><path d="M20 17v2a1 1 0 0 1-1 1h-2"/><path d="M8 8v8M12 8v8M16 8v8"/></svg>
          Bipar
        </button>
      </div>

      <input id="buscaSerial" type="text" class="control" placeholder="Pesquisar serial...">
      <div class="lista-maquinas" id="listaMaquinas"></div>
    </div>

    <!-- SELECIONADAS -->
    <div class="panel">
      <div class="section-title">Selecionadas</div>
      <div class="selecionadas-box">
        <ul id="listaSelecionadas"></ul>
      </div>
    </div>

  </div>

  <!-- FORMULÁRIO -->
  <form id="formEnvio" style="margin-top: 25px;">

    <div class="panel">

      <div class="campo">
        <label>Ação</label>
        <select name="acao" id="acaoSelect" class="control" required>
          <option value="">Selecione...</option>
          <option value="Envio SP">Envio SP</option>
          <option value="Envio RJ">Envio RJ</option>
          <option value="Envio URA">Envio URA</option>
          <option value="Envio Fixo">Envio Fixo</option>
          <option value="Retorno SP">Retorno SP</option>
          <option value="Retorno RJ">Retorno RJ</option>
          <option value="Retorno URA">Retorno URA</option>
        </select>
      </div>

      <!-- ✅ ID EVENTO (só envio) -->
      <div class="campo" id="grpIdEvento">
        <label>ID Evento</label>
        <!-- sem setinhas -->
        <input
          type="text"
          inputmode="numeric"
          pattern="[0-9]*"
          name="id_evento"
          id="idEvento"
          class="control"
          placeholder="Ex: 66689"
        >
        <!-- eco ao vivo do nome do evento + cadastro rápido quando não existe -->
        <div id="ecoEvento" style="font-size:13px;margin-top:6px;min-height:18px;"></div>
        <div id="formNovoEvento" style="display:none;margin-top:8px;padding:10px;border:1px solid var(--border);border-radius:8px;background:var(--surface-2);">
          <div style="font-weight:600;margin-bottom:6px;font-size:13px;">Cadastrar evento <span id="novoEventoId"></span></div>
          <input type="text" id="novoEventoNome" class="control" placeholder="Nome do evento" style="margin-bottom:6px;">
          <input type="text" id="novoEventoProdutora" class="control" placeholder="Produtora (opcional)" style="margin-bottom:6px;">
          <input type="text" id="novoEventoComercial" class="control" placeholder="Comercial (opcional)" style="margin-bottom:6px;">
          <button type="button" id="btnSalvarEvento" class="btn btn-primary btn-sm">Salvar evento</button>
        </div>
      </div>

      <!-- ✅ DATA ENVIO / SAÍDA (só envio, inclusive fixo) -->
      <div class="campo" id="grpDataSaida">
        <label>Data de Envio</label>
        <input type="date" name="dt_saida" id="dtSaida" class="control">
      </div>

      <!-- ✅ DATA RETORNO (só envio normal, não fixo) -->
      <div class="campo" id="grpDataRetorno">
        <label>Data de Retorno</label>
        <input type="date" name="dt_retorno" id="dtRetorno" class="control">
      </div>

      <div class="campo">
        <label>Observações</label>
        <textarea name="obs" id="obs" class="control" rows="3" placeholder="Opcional..."></textarea>
      </div>

    </div>

    <button type="submit" class="btn btn-primary btn-registrar" id="btnRegistrar">
      Registrar movimentação
    </button>

  </form>

</div>

<script>
/* ===============================
   DADOS DO SERVIDOR
=============================== */
const maquinas = <%- JSON.stringify(maquinas || []) %>;

/* ===============================
   ESTADO
=============================== */
let selecionadas = [];
let maquinasPorSerial = {};

/* ===============================
   ELEMENTOS
=============================== */
const lista = document.getElementById("listaMaquinas");
const listaSel = document.getElementById("listaSelecionadas");
const busca = document.getElementById("buscaSerial");
const acaoSelect = document.getElementById("acaoSelect");

const grpIdEvento = document.getElementById("grpIdEvento");
const grpDataSaida = document.getElementById("grpDataSaida");
const grpDataRetorno = document.getElementById("grpDataRetorno");

const form = document.getElementById("formEnvio");
const btnRegistrar = document.getElementById("btnRegistrar");

/* ===============================
   INDEXAR STATUS POR SERIAL
=============================== */
// índice normalizado (serial cru do barcode pode vir com caixa/espaço diferente da planilha)
const normSerial = s => String(s || "").toUpperCase().replace(/\s+/g, "");
const serialCanonicoPorNorm = {};
maquinas.forEach(m => {
  const serial = String(m.serial || "").trim();
  maquinasPorSerial[serial] = String(m.status || "").trim();
  if (serial) serialCanonicoPorNorm[normSerial(serial)] = serial;   // sempre empurramos o serial CANÔNICO da planilha
});

/* ===============================
   RENDER LISTA
=============================== */
function renderLista(filtro = "") {
  lista.innerHTML = "";

  // 🔥 quebra por vírgula e limpa espaços
  const termos = filtro
    .toLowerCase()
    .split(",")
    .map(t => t.trim())
    .filter(t => t !== "");

  const filtradas = maquinas.filter(m => {
    const serial = String(m.serial || "").toLowerCase();

    // se não digitou nada, mostra tudo
    if (termos.length === 0) return true;

    // mostra se bater com QUALQUER serial digitado
    return termos.some(t => serial.includes(t));
  });


  filtradas.forEach(m => {
    const serial = String(m.serial || "").trim();
    const status = String(m.status || "").trim();

    const div = document.createElement("div");
    div.className = "item-maq";
    div.textContent = `${serial} - ${status}`;

    if (selecionadas.includes(serial)) div.classList.add("selecionada");

    div.onclick = () => {
      if (selecionadas.includes(serial)) {
        selecionadas = selecionadas.filter(x => x !== serial);
      } else {
        selecionadas.push(serial);
      }
      renderLista(busca.value);
      renderSel();
    };

    lista.appendChild(div);
  });
}

/* ===============================
   RENDER SELECIONADAS
=============================== */
function renderSel() {
  listaSel.innerHTML = "";

  if (selecionadas.length === 0) {
    listaSel.innerHTML =
      "<li style='color:#777;text-align:center;justify-content:center;'>Nenhuma máquina selecionada</li>";
    return;
  }

  selecionadas.forEach(s => {
    const li = document.createElement("li");
    const status = String(maquinasPorSerial[s] || "").trim();
    const statusHtml = status
      ? `<span class="sel-status">${status.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")}</span>`
      : "";

    li.innerHTML = `
      <span class="sel-main">
        <span class="serial-text">${s}</span>
        ${statusHtml}
      </span>
      <button type="button" class="btn btn-danger btn-sm" onclick="removerSel('${s.replace(/'/g, "\\'")}')">×</button>
    `;

    listaSel.appendChild(li);
  });
}

function removerSel(s) {
  selecionadas = selecionadas.filter(x => x !== s);
  renderLista(busca.value);
  renderSel();
}

/* ===============================
   REGRAS DE CAMPOS (ENVIO/RETORNO)
=============================== */
function atualizarCamposPorAcao() {
  const acao = acaoSelect.value || "";

  const isEnvio = acao.includes("Envio");
  const isRetorno = acao.includes("Retorno");
  const isEnvioFixo = acao === "Envio Fixo";

  // Envio: mostra ID + data envio
  grpIdEvento.style.display = isEnvio ? "block" : "none";
  grpDataSaida.style.display = isEnvio ? "block" : "none";

  // Retorno: não usa essas datas no backend
  if (isRetorno) {
    grpDataRetorno.style.display = "none";
  } else {
    // Envio normal: precisa retorno; Envio Fixo: não
    grpDataRetorno.style.display = (isEnvio && !isEnvioFixo) ? "block" : "none";
  }
}
acaoSelect.addEventListener("change", atualizarCamposPorAcao);
atualizarCamposPorAcao();

/* ===============================
   VALIDAR STATUS (front)
=============================== */
function validarStatus(acao, seriais) {
  const erros = [];

  seriais.forEach(serial => {
    const status = String(maquinasPorSerial[serial] || "").toLowerCase();

    if (acao.includes("Envio")) {
      if (status.includes("em uso") || status.includes("fixo")) {
        erros.push(`${serial} já está em uso/fixo (${maquinasPorSerial[serial]})`);
      }
    }

    if (acao.includes("Retorno")) {
      // ✅ permite retorno de "Em Uso" e de "Fixo"
      if (!(status.includes("em uso") || status.includes("fixo"))) {
        erros.push(`${serial} não está em uso/fixo (status atual: ${maquinasPorSerial[serial] || "-"})`);
      }
    }
  });

  return erros;
}

/* ===============================
   SUBMIT
=============================== */
async function enviarPayload(payload) {
  const resp = await fetch("/api/registrar-envio", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(payload)
  });

  // se backend devolver html por algum motivo, isso pode quebrar
  const contentType = resp.headers.get("content-type") || "";
  if (!contentType.includes("application/json")) {
    const txt = await resp.text();
    return { ok: false, msg: "Resposta inválida do servidor.", raw: txt };
  }

  return await resp.json();
}

form.addEventListener("submit", async (e) => {
  e.preventDefault();

  const acao = acaoSelect.value;

  const id_evento = (document.getElementById("idEvento").value || "").trim();
  const dt_saida = document.getElementById("dtSaida").value || "";
  const dt_retorno = document.getElementById("dtRetorno").value || "";
  const obs = document.getElementById("obs").value || "";

  if (!acao) { showToast("Selecione uma ação.", "err"); return; }
  if (selecionadas.length === 0) { showToast("Selecione ao menos 1 máquina.", "err"); return; }

  const isEnvio = acao.includes("Envio");
  const isRetorno = acao.includes("Retorno");
  const isEnvioFixo = acao === "Envio Fixo";

  // validações do fluxo (igual backend)
  if (isEnvio) {
    if (!id_evento) { showToast("Informe o ID do Evento.", "err"); return; }
    if (!dt_saida) { showToast("Informe a Data de Envio.", "err"); return; }
    if (!isEnvioFixo && !dt_retorno) { showToast("Informe a Data de Retorno (Envio Fixo dispensa).", "err"); return; }
  }

  // valida status
  const erros = validarStatus(acao, selecionadas);
  if (erros.length) { showToast("Ajuste antes de prosseguir: " + erros.join(" · "), "err"); return; }

  btnRegistrar.disabled = true;
  const txtOriginal = btnRegistrar.textContent;
  btnRegistrar.textContent = "Registrando...";

  try {
    // payload alinhado ao backend
    const payload = {
      acao,
      seriais: selecionadas,
      id_evento: isEnvio ? id_evento : "",
      dt_saida: isEnvio ? dt_saida : "",
      dt_retorno: (isEnvio && !isEnvioFixo) ? dt_retorno : "",
      obs
    };

    let data = await enviarPayload(payload);

    // se retorno precisar origem manual (popup)
    if (data && data.needsPopup) {
      const origem = await uiPrompt(
        "Alguns seriais não têm histórico de origem. Digite uma observação de origem (ex: 'veio do estoque X'):"
      );

      if (!origem) {
        showToast("Operação cancelada. Sem origem não é possível registrar esses retornos.", "err");
        return;
      }

      // reenviar com obs_origem (backend já espera isso)
      data = await enviarPayload({ ...payload, obs_origem: origem });
    }

    if (data && data.ok) {
      showToast("Movimentação registrada");
      setTimeout(() => location.reload(), 1100); // recarrega p/ refletir os novos status
    } else {
      showToast((data && data.msg) ? data.msg : "Erro ao registrar.", "err");
    }
  } catch (err) {
    showToast("Erro de rede.", "err");
  } finally {
    btnRegistrar.disabled = false;
    btnRegistrar.textContent = txtOriginal;
  }
});

/* INIT */
busca.addEventListener("input", () => renderLista(busca.value));
renderLista("");

/* ===============================
   BIPAR (scanner de câmera) — popula `selecionadas` lendo o código de barras.
   Devolve 'ok'|'dup'|'notfound' → o scanner (scanner.js) dá o feedback (beep/toast).
=============================== */
function biparSerial(codigo) {
  const canon = serialCanonicoPorNorm[normSerial(codigo)];
  if (!canon) return "notfound";
  if (selecionadas.includes(canon)) return "dup";
  selecionadas.push(canon);                    // canônico da planilha (backend resolve linha por serial exato)
  renderLista(busca.value);
  renderSel();
  return "ok";
}
const btnBipar = document.getElementById("btnBipar");
if (btnBipar) {
  if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
    btnBipar.style.display = "none";           // sem câmera → some (desktop segue clicando/digitando)
  } else {
    btnBipar.addEventListener("click", () => {
      if (typeof ScannerBipe === "undefined") { showToast("Leitor ainda carregando, tente de novo.", "err"); return; }
      ScannerBipe.abrir({
        onLeu: biparSerial,
        existing: selecionadas.slice(),
        statusDe: (code) => { const c = serialCanonicoPorNorm[normSerial(code)]; return c ? (maquinasPorSerial[c] || "") : ""; },
        titulo: "Bipar máquina"
      });
    });
  }
}

/* ===============================
   DATA DE ENVIO DEFAULT = HOJE em BRT (injetado pelo servidor — não usar o
   relógio do navegador, cujo fuso pode divergir do BRT)
=============================== */
(function () {
  const iso = "<%= typeof hojeISO !== 'undefined' ? hojeISO : '' %>"; // aaaa-mm-dd BRT
  const dtSaidaEl = document.getElementById("dtSaida");
  if (dtSaidaEl && !dtSaidaEl.value && iso) dtSaidaEl.value = iso;
})();

/* ===============================
   LOOKUP AO VIVO DO EVENTO + CADASTRO RÁPIDO
   - blur no ID → GET /api/evento/:id → eco do nome (verde) ou "cadastrar" (vermelho)
=============================== */
const idEvento = document.getElementById("idEvento");
const ecoEvento = document.getElementById("ecoEvento");
const formNovoEvento = document.getElementById("formNovoEvento");

async function lookupEvento() {
  if (!idEvento || !ecoEvento) return;
  const id = idEvento.value.trim();
  if (formNovoEvento) formNovoEvento.style.display = "none";
  if (!id) { ecoEvento.textContent = ""; return; }
  ecoEvento.style.color = "var(--muted)";
  ecoEvento.textContent = "Verificando evento…";
  try {
    const r = await fetch("/api/evento/" + encodeURIComponent(id));
    if (r.ok) {
      const data = await r.json();
      const ev = data.evento || {};
      const prod = ev.produtora && ev.produtora !== "-" ? " — " + ev.produtora : "";
      ecoEvento.style.color = "var(--pill-ok-fg)";
      ecoEvento.textContent = "Evento: " + (ev.nome_evento || "-") + prod;
    } else if (r.status === 404) {
      ecoEvento.style.color = "var(--danger)";
      ecoEvento.textContent = "ID não encontrado. ";
      const b = document.createElement("button");
      b.type = "button";
      b.textContent = "Cadastrar este evento";
      b.style.cssText = "background:none;border:none;color:var(--brand);text-decoration:underline;cursor:pointer;padding:0;font-size:13px;font-weight:600;";
      b.addEventListener("click", () => {
        document.getElementById("novoEventoId").textContent = "#" + id;
        formNovoEvento.style.display = "";
        document.getElementById("novoEventoNome").focus();
      });
      ecoEvento.appendChild(b);
    } else {
      ecoEvento.style.color = "var(--danger)";
      ecoEvento.textContent = "Não foi possível validar o evento agora. Tente de novo.";
    }
  } catch (e) {
    ecoEvento.style.color = "var(--danger)";
    ecoEvento.textContent = "Erro de rede ao validar o evento.";
  }
}

if (idEvento) idEvento.addEventListener("blur", lookupEvento);

const btnSalvarEvento = document.getElementById("btnSalvarEvento");
if (btnSalvarEvento) {
  btnSalvarEvento.addEventListener("click", async () => {
    const id = idEvento.value.trim();
    const nome = document.getElementById("novoEventoNome").value.trim();
    if (!id || !nome) { showToast("Informe ao menos o ID e o nome do evento.", "err"); return; }
    btnSalvarEvento.disabled = true;
    try {
      const r = await fetch("/api/evento", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          id_evento: id,
          nome,
          produtora: document.getElementById("novoEventoProdutora").value.trim(),
          comercial: document.getElementById("novoEventoComercial").value.trim()
        })
      });
      const data = await r.json();
      if (data.ok) {
        showToast("Evento cadastrado.");
        await lookupEvento(); // re-valida: agora o evento existe → eco verde
      } else {
        showToast(data.msg || "Não foi possível cadastrar o evento.", "err");
      }
    } catch (e) {
      showToast("Erro de rede ao cadastrar o evento.", "err");
    } finally {
      btnSalvarEvento.disabled = false;
    }
  });
}
renderSel();
</script>

<!-- Scanner "Bipe" (câmera) — só nesta tela: bundle (ilha React) do BarcodeScanner REAL do torre -->
<script defer src="/vendor/scanner-torre.js"></script>

<%- include('partials/footer') %>
