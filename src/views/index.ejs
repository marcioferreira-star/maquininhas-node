<%- include('partials/header') %>
<%- include('partials/sidebar', { page: 'dashboard', user }) %>

<div class="main-content">

  <h1>Dashboard</h1>

  <% if (typeof erro !== "undefined" && erro) { %>
    <div class="alert alert--danger">
      Não foi possível carregar os dados agora — a planilha está indisponível. Recarregue a página em instantes.
    </div>
  <% } %>

  <!-- KPIs clicáveis: cada card abre a tela Máquinas já filtrada (querystring). -->
  <div class="kpi-grid">
    <a href="/maquinas" class="kpi-link" aria-label="Ver todas as máquinas">
      <div class="kpi">
        <div class="kpi__top">
          <span class="kpi__label">Total</span>
          <span class="kpi__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path d="M12 12l8-4.5"/><path d="M12 12v9"/><path d="M12 12L4 7.5"/></svg></span>
        </div>
        <div class="kpi__value" id="kpiTotal">0</div>
      </div>
    </a>

    <a href="/maquinas?f=estoque" class="kpi-link" aria-label="Ver máquinas disponíveis (em estoque)">
      <div class="kpi">
        <div class="kpi__top">
          <span class="kpi__label">Disponíveis</span>
          <span class="kpi__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M9 12l2 2l4-4"/></svg></span>
        </div>
        <div class="kpi__value" id="kpiDisp">0</div>
        <div class="kpi__sub">
          <div><span>SP</span><b id="kpiDispSP">0</b></div>
          <div><span>RJ</span><b id="kpiDispRJ">0</b></div>
          <div><span>URA</span><b id="kpiDispURA">0</b></div>
        </div>
      </div>
    </a>

    <a href="/maquinas?f=em%20uso" class="kpi-link" aria-label="Ver máquinas em uso">
      <div class="kpi">
        <div class="kpi__top">
          <span class="kpi__label">Em Uso</span>
          <span class="kpi__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 7h11v9H2z"/><path d="M13 10h4l3 3v3h-3"/><circle cx="6.5" cy="18" r="1.7"/><circle cx="17" cy="18" r="1.7"/></svg></span>
        </div>
        <div class="kpi__value" id="kpiUso">0</div>
      </div>
    </a>

    <a href="/maquinas?retorno=atrasada" class="kpi-link" aria-label="Ver máquinas atrasadas">
      <div class="kpi kpi--accent">
        <div class="kpi__top">
          <span class="kpi__label">Atrasadas</span>
          <span class="kpi__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
        </div>
        <div class="kpi__value" id="kpiAtras">0</div>
      </div>
    </a>

    <a href="/maquinas?f=fixo" class="kpi-link" aria-label="Ver máquinas fixas">
      <div class="kpi">
        <div class="kpi__top">
          <span class="kpi__label">Fixas</span>
          <span class="kpi__ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c4-5 6-8 6-11a6 6 0 1 0-12 0c0 3 2 6 6 11z"/><circle cx="12" cy="10" r="2"/></svg></span>
        </div>
        <div class="kpi__value" id="kpiFixas">0</div>
      </div>
    </a>
  </div>

  <script>
    const resumo = <%- JSON.stringify(resumo || {}) %>;

    function animateCount(el, target, duration = 900) {
      let start = 0;
      const step = 20;
      const increment = target / (duration / step);

      const counter = setInterval(() => {
        start += increment;
        if (start >= target) {
          start = target;
          clearInterval(counter);
        }
        el.textContent = Math.floor(start);
      }, step);
    }

    animateCount(document.getElementById("kpiTotal"), resumo.total || 0);
    animateCount(document.getElementById("kpiDisp"), resumo.disponiveis || 0);
    animateCount(document.getElementById("kpiDispSP"), resumo.disponiveisSP || 0);
    animateCount(document.getElementById("kpiDispRJ"), resumo.disponiveisRJ || 0);
    animateCount(document.getElementById("kpiDispURA"), resumo.disponiveisURA || 0);
    animateCount(document.getElementById("kpiUso"), resumo.emUso || 0);
    animateCount(document.getElementById("kpiFixas"), resumo.fixas || 0);
    animateCount(document.getElementById("kpiAtras"), resumo.atrasadas || 0);
  </script>
</div>

<%- include('partials/footer') %>