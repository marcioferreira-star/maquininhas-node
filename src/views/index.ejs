<%- include('partials/header') %>
<%- include('partials/sidebar', { page: 'dashboard', user }) %>

<div class="main-content">
  <style>
    h1 {
      font-size: 28px;
      font-weight: 800;
      margin: 0 0 18px 0;
    }
    .kpis{
      display: grid !important;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 16px;
      width: 100%;
      max-width: 100%;
      min-width: 0;
    }
    @media (min-width: 1500px){
      .kpis{
        grid-template-columns: repeat(5, minmax(220px, 1fr));
      }
    }
    /* cards de superfície com ícone acentuado (identidade Ingresse, light+dark) */
    .card-kpi {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 16px 18px;
      display: flex;
      align-items: center;
      gap: 15px;
      box-shadow: var(--shadow);
      min-height: 92px;
      min-width: 0;
      width: 100%;
      transition: transform .16s ease, box-shadow .16s ease, border-color .16s ease;
    }
    a:hover .card-kpi {
      transform: translateY(-2px);
      box-shadow: var(--shadow-lg);
      border-color: var(--muted);
    }
    .kpi-icon {
      width: 48px;
      height: 48px;
      border-radius: 13px;
      display: grid;
      place-items: center;
      flex: 0 0 auto;
    }
    .kpi-icon svg { width: 24px; height: 24px; }
    .kpi-body { min-width: 0; }
    .kpi-label { font-size: 13.5px; font-weight: 600; color: var(--muted); }
    .kpi-value { font-size: 32px; font-weight: 800; color: var(--text); line-height: 1.05; margin-top: 2px; }
    /* accent por métrica — só o ícone é colorido (tinta suave); Atrasadas usa Blood Orange */
    .kpi-total     .kpi-icon { background: rgba(11,92,173,.14);  color: var(--info); }
    .kpi-disp      .kpi-icon { background: rgba(31,122,55,.16);  color: var(--ok); }
    .kpi-uso       .kpi-icon { background: rgba(180,120,20,.18); color: var(--warn); }
    .kpi-atrasadas .kpi-icon { background: rgba(255,39,26,.14);  color: var(--brand); }
    .kpi-fixas     .kpi-icon { background: rgba(124,92,255,.18); color: #7c5cff; }
    .subkpis { display: flex; gap: 14px; margin-top: 8px; }
    .subkpis .kpi-label { font-size: 11.5px; }
    .subkpis .kpi-value { font-size: 19px; font-weight: 700; }
    @media (max-width: 480px){
      .kpi-value{ font-size: 28px; }
    }
    /* Sincronização manual (planilha → espelho Neon) */
    .sync-box {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
      margin: 4px 0 24px;
    }
    .sync-status { color: var(--muted); font-size: 13px; }
    #btnSync[disabled] { opacity: 0.6; cursor: progress; }
    #btnSync svg { vertical-align: -3px; }
  </style>

  <h1>Dashboard</h1>

  <% if (typeof erro !== "undefined" && erro) { %>
    <div style="background:#f8ebe9;border:1px solid #d9534f;color:#a12a22;padding:12px 16px;border-radius:8px;margin-bottom:16px;font-weight:600;">
      Não foi possível carregar os dados agora — a planilha está indisponível. Recarregue a página em instantes.
    </div>
  <% } %>

  <!-- KPIs clicáveis: cada card abre a tela Máquinas já filtrada (querystring). -->
  <div class="kpis">
    <a href="/maquinas" style="display:contents" aria-label="Ver todas as máquinas">
    <div class="card-kpi kpi-total">
      <div class="kpi-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path d="M12 12l8-4.5"/><path d="M12 12v9"/><path d="M12 12L4 7.5"/></svg></div>
      <div class="kpi-body">
        <div class="kpi-label">Total</div>
        <div class="kpi-value" id="kpiTotal">0</div>
      </div>
    </div>
    </a>

    <a href="/maquinas?f=estoque" style="display:contents" aria-label="Ver máquinas disponíveis (em estoque)">
    <div class="card-kpi kpi-disp">
      <div class="kpi-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M9 12l2 2l4-4"/></svg></div>
      <div class="kpi-body">
        <div class="kpi-label">Disponíveis</div>
        <div class="kpi-value" id="kpiDisp">0</div>

        <div class="subkpis">
          <div style="flex:1">
            <div class="kpi-label">SP</div>
            <div class="kpi-value" id="kpiDispSP">0</div>
          </div>
          <div style="flex:1">
            <div class="kpi-label">RJ</div>
            <div class="kpi-value" id="kpiDispRJ">0</div>
          </div>
          <div style="flex:1">
            <div class="kpi-label">URA</div>
            <div class="kpi-value" id="kpiDispURA">0</div>
          </div>
        </div>
      </div>
    </div>
    </a>

    <a href="/maquinas?f=em%20uso" style="display:contents" aria-label="Ver máquinas em uso">
    <div class="card-kpi kpi-uso">
      <div class="kpi-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 7h11v9H2z"/><path d="M13 10h4l3 3v3h-3"/><circle cx="6.5" cy="18" r="1.7"/><circle cx="17" cy="18" r="1.7"/></svg></div>
      <div class="kpi-body">
        <div class="kpi-label">Em Uso</div>
        <div class="kpi-value" id="kpiUso">0</div>
      </div>
    </div>
    </a>

    <a href="/maquinas?retorno=atrasada" style="display:contents" aria-label="Ver máquinas atrasadas">
    <div class="card-kpi kpi-atrasadas">
      <div class="kpi-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></div>
      <div class="kpi-body">
        <div class="kpi-label">Atrasadas</div>
        <div class="kpi-value" id="kpiAtras">0</div>
      </div>
    </div>
    </a>

    <a href="/maquinas?f=fixo" style="display:contents" aria-label="Ver máquinas fixas">
    <div class="card-kpi kpi-fixas">
      <div class="kpi-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c4-5 6-8 6-11a6 6 0 1 0-12 0c0 3 2 6 6 11z"/><circle cx="12" cy="10" r="2"/></svg></div>
      <div class="kpi-body">
        <div class="kpi-label">Fixas</div>
        <div class="kpi-value" id="kpiFixas">0</div>
      </div>
    </div>
    </a>
  </div>

  <!-- Sincronização manual: planilha → espelho Neon (qualquer operador logado) -->
  <div class="sync-box">
    <button type="button" class="btn btn-secondary" id="btnSync">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 11a8 8 0 1 0-2.3 5.7"/><path d="M20 5v6h-6"/></svg>
      Sincronizar agora
    </button>
    <span id="syncStatus" class="sync-status">Última sincronização: carregando…</span>
  </div>

  <script>
    const resumo = <%- JSON.stringify(resumo || {}) %>;

    function animateCount(el, target, duration = 900) {
      let start = 0;
      const step = 20;
      const increment = target / (duration / step);

      const counter = setInterval(() => {
        start += increment;
        if (start >= target) {
          start = target;
          clearInterval(counter);
        }
        el.textContent = Math.floor(start);
      }, step);
    }

    animateCount(document.getElementById("kpiTotal"), resumo.total || 0);
    animateCount(document.getElementById("kpiDisp"), resumo.disponiveis || 0);
    animateCount(document.getElementById("kpiDispSP"), resumo.disponiveisSP || 0);
    animateCount(document.getElementById("kpiDispRJ"), resumo.disponiveisRJ || 0);
    animateCount(document.getElementById("kpiDispURA"), resumo.disponiveisURA || 0);
    animateCount(document.getElementById("kpiUso"), resumo.emUso || 0);
    animateCount(document.getElementById("kpiFixas"), resumo.fixas || 0);
    animateCount(document.getElementById("kpiAtras"), resumo.atrasadas || 0);

    /* ===== Sincronização manual (planilha → espelho Neon) ===== */
    (function syncUI() {
      const btn = document.getElementById("btnSync");
      const stat = document.getElementById("syncStatus");
      if (!btn || !stat) return;

      // timestamp completo (ISO com fuso) → BRT. new Date(ISO-completo) é seguro
      // (o bug UTC só vale p/ strings de data pura "aaaa-mm-dd").
      function fmtBRT(iso) {
        if (!iso) return "—";
        try {
          return new Date(iso).toLocaleString("pt-BR", {
            timeZone: "America/Sao_Paulo",
            day: "2-digit", month: "2-digit", hour: "2-digit", minute: "2-digit"
          });
        } catch (e) { return "—"; }
      }
      function pintaStatus(u) {
        if (!u) { stat.textContent = "Última sincronização: nunca"; return; }
        const origem = String(u.origem || "").startsWith("manual") ? "manual" : "automática";
        stat.textContent = u.ok
          ? `Última sincronização: ${fmtBRT(u.executado_em)} (${origem})`
          : `Última sincronização: ${fmtBRT(u.executado_em)} — falhou`;
      }
      async function carregar() {
        try {
          const r = await fetch("/api/sync-status");
          const d = await r.json();
          pintaStatus(d.ultimo);
        } catch (e) { stat.textContent = "Última sincronização: —"; }
      }
      carregar();

      btn.addEventListener("click", async () => {
        btn.disabled = true;
        const original = btn.innerHTML;
        btn.textContent = "Sincronizando…";
        try {
          const r = await fetch("/api/sync-manual", {
            method: "POST",
            headers: { "Content-Type": "application/json" }
          });
          const d = await r.json();
          if (r.status === 409) {
            showToast(d.msg || "Já há uma sincronização em andamento.", "err");
          } else if (d.ok) {
            showToast(`Sincronizado: ${d.maquina} máquinas em ${(d.ms / 1000).toFixed(1)}s`);
          } else {
            showToast(d.msg || "Falha ao sincronizar.", "err");
          }
        } catch (e) {
          showToast("Erro de rede ao sincronizar.", "err");
        } finally {
          btn.innerHTML = original;
          btn.disabled = false;
          carregar();
        }
      });
    })();
  </script>
</div>

<%- include('partials/footer') %>