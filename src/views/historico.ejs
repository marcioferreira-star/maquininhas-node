<%- include('partials/header') %>
<%- include('partials/sidebar', { page: 'historico', user }) %>

<style>
/* ------------------------- */
/* CAIXA DE FILTROS */
/* ------------------------- */
.filter-box {
  background: var(--surface);
  padding: 18px;
  border-radius: 12px;
  border: 1px solid var(--border);
  display: flex;
  gap: 15px;
  margin-bottom: 22px;
  box-shadow: var(--shadow);
}

.filter-box input,
.filter-box select {
  flex: 1;
  height: 40px;
  border-radius: 8px;
  border: 1px solid var(--border);
  background: var(--surface);
  color: var(--text);
  padding-left: 12px;
  font-size: 15px;
}

/* ------------------------- */
/* ÁREA DA TABELA */
/* ------------------------- */
.box-wrapper {
  background: var(--surface);
  padding: 0;
  border-radius: 14px;
  border: 1px solid var(--border);
  overflow: hidden;
  box-shadow: var(--shadow);
}

/* ------------------------- */
/* CABEÇALHO */
/* ------------------------- */
.table-head {
  width: 100%;
  background: var(--table-head-bg);
  border-bottom: 1px solid var(--border);
  z-index: 5;
  overflow-x: hidden; /* desktop ok */
}

.table-history {
  width: 100%;
  border-collapse: collapse;
  table-layout: fixed; /* desktop ok */
}

.table-history thead th {
  padding: 12px;
  color: var(--table-head-fg);
  font-size: 14px;
  font-weight: 600;
  text-align: left;
  border-right: 1px solid rgba(255,255,255,0.1);
}

.table-history thead th:last-child {
  border-right: none;
}

/* ------------------------- */
/* CORPO COM SCROLL */
/* ------------------------- */
.table-body {
  max-height: 490px;
  overflow-y: auto;
  overflow-x: hidden; /* no mobile a gente libera */
}

.table-body::-webkit-scrollbar {
  width: 8px;
}
.table-body::-webkit-scrollbar-thumb {
  background: #b7b7b7;
  border-radius: 20px;
}
.table-body::-webkit-scrollbar-thumb:hover {
  background: #929292;
}

/* ------------------------- */
/* LINHAS DA TABELA */
/* ------------------------- */
.table-history tbody tr {
  background: var(--surface);
  transition: 0.15s;
}

.table-history tbody tr:nth-child(odd) {
  background: var(--surface-2);
}

.table-history tbody tr:hover {
  background: var(--surface-3);
}

.table-history td {
  padding: 12px;
  font-size: 14px;
  color: var(--text);
  border-bottom: 1px solid var(--border);
  word-wrap: break-word;
}

/* ------------------------- */
/* SEM RESULTADOS */
/* ------------------------- */
.empty-msg {
  text-align: center;
  padding: 25px;
  color: var(--muted);
  font-size: 15px;
}

/* ✅ MOBILE: filtros quebram e tabela vira scroll horizontal (sem texto “em pé”) */
@media (max-width: 900px){
  .filter-box{
    flex-wrap: wrap;
  }
  .filter-box input,
  .filter-box select{
    flex: 1 1 48%;
    min-width: 160px;
  }

  .box-wrapper{
    overflow: auto;
    -webkit-overflow-scrolling: touch;
  }

  .table-head{
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .table-body{
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .table-history{
    min-width: 1100px;
    table-layout: auto !important;
  }

  .table-history th,
  .table-history td{
    white-space: nowrap;
    word-wrap: normal;
  }
}
</style>

<div class="main-content">

  <h1 style="margin-bottom: 22px; font-weight:700;">Histórico de Movimentações</h1>

  <% if (typeof erro !== "undefined" && erro) { %>
    <div style="background:#f8ebe9;border:1px solid #d9534f;color:#a12a22;padding:12px 16px;border-radius:8px;margin-bottom:16px;font-weight:600;">
      Não foi possível carregar o histórico agora — a planilha está indisponível. Recarregue em instantes.
    </div>
  <% } %>

  <!-- FILTROS -->
  <div class="filter-box">
    <input type="text" id="filtroSerial" placeholder="Filtrar Serial">
    <input type="text" id="filtroEvento" placeholder="Filtrar ID Evento">
    <select id="filtroAcao">
      <option value="">Filtrar Ação</option>
      <option value="envio">Envio</option>
      <option value="retorno">Retorno</option>
      <option value="fixo">Fixo</option>
    </select>
  </div>

  <!-- CAIXA DA TABELA -->
  <div class="box-wrapper">

    <!-- CABEÇALHO FIXO -->
    <div class="table-head">
      <table class="table-history">
        <colgroup>
          <col style="width:10%">
          <col style="width:7%">
          <col style="width:8%">
          <col style="width:9%">
          <col style="width:9%">
          <col style="width:12%">
          <col style="width:8%">
          <col style="width:11%">
          <col style="width:11%">
          <col style="width:9%">
          <col style="width:6%">
        </colgroup>
        <thead>
          <tr>
            <th>Nº Serial</th>
            <th>ID Evento</th>
            <th>Ação</th>
            <th>Data de Envio</th>
            <th>Data de Retorno</th>
            <th>Status</th>
            <th>Usuário</th>
            <th>Nome Evento</th>
            <th>Produtora</th>
            <th>Comercial</th>
            <th>Observação</th>
          </tr>
        </thead>
      </table>
    </div>

    <!-- CORPO COM SCROLL -->
    <div class="table-body">
      <table class="table-history">
        <colgroup>
          <col style="width:10%">
          <col style="width:7%">
          <col style="width:8%">
          <col style="width:9%">
          <col style="width:9%">
          <col style="width:12%">
          <col style="width:8%">
          <col style="width:11%">
          <col style="width:11%">
          <col style="width:9%">
          <col style="width:6%">
        </colgroup>
        <tbody id="bodyHistorico">

          <% if (!historico || historico.length === 0) { %>
            <tr><td colspan="11" class="empty-msg">Nenhum registro encontrado</td></tr>
          <% } else { %>
            <% [...historico].reverse().forEach(h => { %>
              <tr>
                <td><%= h.serial || "-" %></td>
                <td><%= h.evento || "-" %></td>
                <td><%= h.acao || "-" %></td>
                <td><%= h.saida || "-" %></td>
                <td><%= h.retorno || "-" %></td>
                <td>
                  <% if (h.situacao) { %>
                    <%
                      const cor =
                        h.situacao === "Atrasado"        ? "#d9534f" :
                        h.situacao === "Vence hoje"      ? "#e0a800" :
                        h.situacao === "Dentro do prazo" ? "#28a745" :
                        h.situacao === "Devolvida"       ? "#5a87c9" :
                        "#6c757d"; // Fixo / outros
                      // "Vence hoje" (amarelo) exige texto escuro p/ passar contraste AA
                      const corTexto = h.situacao === "Vence hoje" ? "#1A1A1A" : "#fff";
                    %>
                    <span style="display:inline-block;padding:2px 8px;border-radius:12px;font-size:11px;font-weight:600;color:<%= corTexto %>;background:<%= cor %>;line-height:1.3;"><%= h.situacao %></span>
                  <% } else { %>
                    <%= h.status || "-" %>
                  <% } %>
                </td>
                <td><%= h.usuario || "-" %></td>
                <td><%= h.nome_evento || "-" %></td>
                <td><%= h.produtora || "-" %></td>
                <td><%= h.comercial || "-" %></td>
                <td><%= h.obs || "-" %></td>
              </tr>
            <% }) %>
          <% } %>

        </tbody>
      </table>
    </div>

  </div>
</div>

<%- include('partials/footer') %>

<script>
const filtroSerial = document.getElementById("filtroSerial");
const filtroEvento = document.getElementById("filtroEvento");
const filtroAcao   = document.getElementById("filtroAcao");

const tabela = document.getElementById("bodyHistorico");

/* =====================================================
   SUPORTE A MÚLTIPLOS SERIAIS E EVENTOS
===================================================== */
function parseLista(value) {
  return value
    .toLowerCase()
    .replace(/\s+/g, "")
    .split(/[,;\n]+/g)
    .filter(x => x !== "");
}

function aplicarFiltros() {
  const listaSeriais = parseLista(filtroSerial.value);
  const listaEventos = parseLista(filtroEvento.value);
  const acaoFiltro   = filtroAcao.value.toLowerCase();

  for (const row of tabela.rows) {
    let show = true;

    const colSerial = row.cells[0].innerText.toLowerCase().replace(/\s+/g, "");
    const colEvento = row.cells[1].innerText.toLowerCase().replace(/\s+/g, "");
    const colAcao   = row.cells[2].innerText.toLowerCase();

    if (listaSeriais.length > 0 && !listaSeriais.some(v => colSerial.includes(v)))
      show = false;

    if (listaEventos.length > 0 && !listaEventos.some(v => colEvento.includes(v)))
      show = false;

    if (acaoFiltro && !colAcao.includes(acaoFiltro))
      show = false;

    row.style.display = show ? "" : "none";
  }
}

filtroSerial.addEventListener("input", aplicarFiltros);
filtroEvento.addEventListener("input", aplicarFiltros);
filtroAcao.addEventListener("change", aplicarFiltros);

/* ✅ sincroniza scroll do cabeçalho com o corpo (ajuda MUITO no mobile) */
(function syncScroll(){
  const tb = document.querySelector(".table-body");
  const th = document.querySelector(".table-head");
  if (!tb || !th) return;
  tb.addEventListener("scroll", () => {
    th.scrollLeft = tb.scrollLeft;
  });
})();
</script>
