<%- include('partials/header') %>
<%- include('partials/sidebar', { page: 'historico', user }) %>

<style>
  /* usa .toolbar/.field/.control/.tbl/.empty do design system (Onda 0) */
  /* tabela preenche a altura disponível (sem buraco embaixo) — escopo só desta tela.
     max-height limita o container flex → a .table-scroll rola internamente (sticky mantém). */
  .main-content { display: flex; flex-direction: column; max-height: calc(100vh - 60px); }
  .table-scroll { flex: 1 1 auto; min-height: 0; max-height: none; }
  /* table-layout:fixed + colgroup = colunas proporcionais (sem lacuna); truncagem por célula */
  .tbl { table-layout: fixed; min-width: 1080px; }
  .tbl tbody td { overflow: hidden; text-overflow: ellipsis; }   /* nowrap é global no .tbl td */
  .nome-cell span, .prod-cell span, .com-cell span, .obs-cell span { vertical-align: middle; }
  .contador { display: inline-block; padding-top: 8px; font-size: var(--fs-sm); color: var(--muted); white-space: nowrap; }

  /* MOBILE (<=720): a tabela vira CARDS (DOM único — tr vira card, td vira linha rótulo:valor) */
  @media (max-width: 720px) {
    /* no mobile a tabela vira CARDS → desfaz o preenchimento flex do desktop */
    .main-content { display: block; max-height: none; }
    .table-scroll { flex: none; max-height: none; overflow: visible; border: 0; background: transparent; }
    .tbl { table-layout: auto; min-width: 0; }
    .tbl thead { display: none; }
    .tbl, .tbl tbody { display: block; }
    .tbl tbody tr.linha {
      display: block; background: var(--surface);
      border: 1px solid var(--border); border-radius: var(--radius-md);
      padding: var(--space-3); margin-bottom: var(--space-3);
    }
    .tbl tbody tr:nth-child(odd) td, .tbl tbody tr:hover td { background: transparent; }
    .tbl tbody tr.linha td {
      display: flex; justify-content: space-between; align-items: flex-start; gap: var(--space-4);
      padding: 5px 0; border: none; white-space: normal; overflow: visible; text-overflow: clip;
    }
    .tbl tbody tr.linha td::before {
      content: attr(data-label); flex: 0 0 auto;
      font-weight: 600; font-size: var(--fs-xs); color: var(--muted);
      text-transform: uppercase; letter-spacing: .03em;
    }
    .tbl tbody tr.linha td.c-serial { font-size: var(--fs-lg); font-weight: 700; padding: 0 0 var(--space-2); margin-bottom: var(--space-2); border-bottom: 1px solid var(--border); }
    .tbl tbody tr.linha td.c-serial::before { display: none; }
    /* no card, sem hover/tooltip: mostra o texto inteiro (quebra linha) */
    .nome-cell span, .prod-cell span, .com-cell span, .obs-cell span {
      max-width: 62%; white-space: normal; overflow: visible; text-overflow: clip; text-align: right;
    }
  }
</style>

<div class="main-content">

  <% if (typeof erro !== "undefined" && erro) { %>
    <div class="alert alert--danger">
      Não foi possível carregar o histórico agora — a planilha está indisponível. Recarregue em instantes.
    </div>
  <% } %>

  <!-- FILTROS -->
  <div class="toolbar">
    <div class="field"><label>Serial</label><input type="text" class="control" id="filtroSerial" placeholder="ex: PBA123, 11703"></div>
    <div class="field"><label>ID Evento</label><input type="text" class="control" id="filtroEvento" placeholder="ID do evento"></div>
    <div class="field"><label>Ação</label>
      <select class="control" id="filtroAcao" data-label="Ação">
        <option value="">Todas</option>
        <option value="envio">Envio</option>
        <option value="retorno">Retorno</option>
        <option value="fixo">Fixo</option>
      </select>
    </div>
    <div class="field"><label>&nbsp;</label><span id="contadorHist" class="contador"></span></div>
  </div>

  <!-- TABELA (uma só: .table-scroll = scroll interno 68vh + thead sticky) -->
  <div class="table-scroll">
    <table class="tbl">
      <colgroup>
        <col style="width:11%">   <!-- Serial -->
        <col style="width:7%">    <!-- ID Evento -->
        <col style="width:8%">    <!-- Ação -->
        <col style="width:8.5%">  <!-- Data Envio -->
        <col style="width:8.5%">  <!-- Data Retorno -->
        <col style="width:8%">    <!-- Usuário -->
        <col style="width:14%">   <!-- Nome Evento -->
        <col style="width:12%">   <!-- Produtora -->
        <col style="width:11%">   <!-- Comercial -->
        <col style="width:12%">   <!-- Observação -->
      </colgroup>
      <thead>
        <tr>
          <th>Nº Serial</th>
          <th>ID Evento</th>
          <th>Ação</th>
          <th>Data Envio</th>
          <th>Data Retorno</th>
          <th>Usuário</th>
          <th>Nome Evento</th>
          <th>Produtora</th>
          <th>Comercial</th>
          <th>Observação</th>
        </tr>
      </thead>
      <tbody id="bodyHistorico">

        <% if (!historico || historico.length === 0) { %>
          <tr><td colspan="10" class="empty">Nenhum registro encontrado</td></tr>
        <% } else { %>
          <% [...historico].reverse().forEach(h => { %>
            <tr class="linha">
              <td class="c-serial" data-label="Serial"><%= h.serial || "-" %></td>
              <td data-label="ID Evento"><%= h.evento || "-" %></td>
              <td data-label="Ação"><%= h.acao || "-" %></td>
              <td data-label="Data Envio"><%= h.saida || "-" %></td>
              <td data-label="Data Retorno"><%= h.retorno || "-" %></td>
              <td data-label="Usuário"><%= h.usuario || "-" %></td>
              <td class="nome-cell" data-label="Nome Evento"><span title="<%= (h.nome_evento && h.nome_evento !== '-') ? h.nome_evento : '' %>"><%= h.nome_evento || "-" %></span></td>
              <td class="prod-cell" data-label="Produtora"><span title="<%= (h.produtora && h.produtora !== '-') ? h.produtora : '' %>"><%= h.produtora || "-" %></span></td>
              <td class="com-cell" data-label="Comercial"><span title="<%= (h.comercial && h.comercial !== '-') ? h.comercial : '' %>"><%= h.comercial || "-" %></span></td>
              <td class="obs-cell" data-label="Observação"><span title="<%= (h.obs && h.obs !== '-') ? h.obs : '' %>"><%= h.obs || "-" %></span></td>
            </tr>
          <% }) %>
        <% } %>

        <tr id="semResultado" style="display:none"><td colspan="10" class="empty">Nenhum registro para esse filtro</td></tr>
      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>

<script>
const filtroSerial = document.getElementById("filtroSerial");
const filtroEvento = document.getElementById("filtroEvento");
const filtroAcao   = document.getElementById("filtroAcao");

const tabela    = document.getElementById("bodyHistorico");
const contador  = document.getElementById("contadorHist");
const semResult = document.getElementById("semResultado");

function normalizar(v) {
  return String(v || "").toLowerCase().replace(/\s+/g, "");
}

/* =====================================================
   ÍNDICE EM MEMÓRIA (lido UMA vez no load)
   Antes o filtro lia `innerText` de 3 células por linha a cada tecla; com ~1.4k
   linhas isso são milhares de reflows forçados por caractere → travava a tela.
   `textContent` não força layout, e aqui nem é relido: fica cacheado.
===================================================== */
const linhas = Array.from(tabela.querySelectorAll("tr.linha")).map(tr => ({
  el: tr,
  serial: normalizar(tr.cells[0].textContent),
  evento: normalizar(tr.cells[1].textContent),
  acao:   String(tr.cells[2].textContent || "").toLowerCase(),
  visivel: true
}));

/* =====================================================
   SUPORTE A MÚLTIPLOS SERIAIS E EVENTOS
   Separadores aceitos: espaço, TAB, quebra de linha, vírgula, ponto e vírgula,
   pipe e barra — para colar direto do scanner ("Copiar" separa por espaço),
   de planilha (TAB/linhas), do WhatsApp ou de lista com vírgula.
===================================================== */
function parseLista(value) {
  return String(value || "")
    .toLowerCase()
    .split(/[\s,;|/]+/)
    .filter(x => x !== "");
}

function aplicarFiltros() {
  const listaSeriais = parseLista(filtroSerial.value);
  const listaEventos = parseLista(filtroEvento.value);
  const acaoFiltro   = filtroAcao.value.toLowerCase();
  const filtrando    = listaSeriais.length > 0 || listaEventos.length > 0 || !!acaoFiltro;

  let visiveis = 0;

  for (const l of linhas) {
    const show =
      (listaSeriais.length === 0 || listaSeriais.some(v => l.serial.includes(v))) &&
      (listaEventos.length === 0 || listaEventos.some(v => l.evento.includes(v))) &&
      (!acaoFiltro || l.acao.includes(acaoFiltro));

    // só escreve no DOM quando o estado MUDA (evita layout desnecessário)
    if (show !== l.visivel) {
      l.el.style.display = show ? "" : "none";
      l.visivel = show;
    }
    if (show) visiveis++;
  }

  if (semResult) semResult.style.display = (filtrando && visiveis === 0) ? "" : "none";
  if (contador) {
    contador.textContent = filtrando
      ? `${visiveis} de ${linhas.length} registros`
      : `${linhas.length} registros`;
  }
}

/* debounce: digitar não dispara um filtro por tecla; Enter aplica na hora */
let timerFiltro = null;
function agendarFiltro() {
  clearTimeout(timerFiltro);
  timerFiltro = setTimeout(aplicarFiltros, 150);
}
function aplicarAgora() {
  clearTimeout(timerFiltro);
  aplicarFiltros();
}

/* Colar de planilha/lista traz quebras de linha e TAB; o <input> de linha única
   DESCARTA esses caracteres e gruda tudo num termo só. Normaliza para espaço. */
function normalizarColagem(el) {
  el.addEventListener("paste", (e) => {
    const txt = ((e.clipboardData || window.clipboardData) || {}).getData?.("text") || "";
    if (!/[\r\n\t]/.test(txt)) return;                     // colagem simples segue o caminho normal
    e.preventDefault();
    const limpo = txt.replace(/[\r\n\t]+/g, " ").trim();
    const ini = el.selectionStart ?? el.value.length;
    const fim = el.selectionEnd ?? el.value.length;
    el.value = el.value.slice(0, ini) + limpo + el.value.slice(fim);
    const pos = ini + limpo.length;
    el.setSelectionRange(pos, pos);
    el.dispatchEvent(new Event("input", { bubbles: true }));
  });
}

[filtroSerial, filtroEvento].forEach(el => {
  normalizarColagem(el);
  el.addEventListener("input", agendarFiltro);
  el.addEventListener("keydown", e => { if (e.key === "Enter") { e.preventDefault(); aplicarAgora(); } });
  el.addEventListener("change", aplicarAgora);   // paste + blur / autofill
});
filtroAcao.addEventListener("change", aplicarAgora);

aplicarFiltros();
</script>
