<%- include('partials/header') %>
<%- include('partials/sidebar', { page: 'historico', user }) %>

<style>
  /* usa .toolbar/.field/.control/.tbl/.empty do design system (Onda 0) */
  .tbl { min-width: 1080px; }                 /* desktop: rola no .table-scroll */
  .nome-cell span, .prod-cell span, .com-cell span, .obs-cell span {
    display: inline-block; max-width: 150px; overflow: hidden;
    text-overflow: ellipsis; white-space: nowrap; vertical-align: middle;
  }

  /* MOBILE (<=720): a tabela vira CARDS (DOM único — tr vira card, td vira linha rótulo:valor) */
  @media (max-width: 720px) {
    .tbl { min-width: 0; }
    .tbl thead { display: none; }
    .tbl, .tbl tbody { display: block; }
    .tbl tbody tr.linha {
      display: block; background: var(--surface);
      border: 1px solid var(--border); border-radius: var(--radius-md);
      padding: var(--space-3); margin-bottom: var(--space-3);
    }
    .tbl tbody tr:nth-child(odd) td, .tbl tbody tr:hover td { background: transparent; }
    .tbl tbody tr.linha td {
      display: flex; justify-content: space-between; align-items: flex-start; gap: var(--space-4);
      padding: 5px 0; border: none; white-space: normal;
    }
    .tbl tbody tr.linha td::before {
      content: attr(data-label); flex: 0 0 auto;
      font-weight: 600; font-size: var(--fs-xs); color: var(--muted);
      text-transform: uppercase; letter-spacing: .03em;
    }
    .tbl tbody tr.linha td.c-serial { font-size: var(--fs-lg); font-weight: 700; padding: 0 0 var(--space-2); margin-bottom: var(--space-2); border-bottom: 1px solid var(--border); }
    .tbl tbody tr.linha td.c-serial::before { display: none; }
    /* no card, sem hover/tooltip: mostra o texto inteiro (quebra linha) */
    .nome-cell span, .prod-cell span, .com-cell span, .obs-cell span {
      max-width: 62%; white-space: normal; overflow: visible; text-overflow: clip; text-align: right;
    }
  }
</style>

<div class="main-content">

  <h1>Histórico de Movimentações</h1>

  <% if (typeof erro !== "undefined" && erro) { %>
    <div class="alert alert--danger">
      Não foi possível carregar o histórico agora — a planilha está indisponível. Recarregue em instantes.
    </div>
  <% } %>

  <!-- FILTROS -->
  <div class="toolbar">
    <div class="field"><label>Serial</label><input type="text" class="control" id="filtroSerial" placeholder="ex: PBA123, 11703"></div>
    <div class="field"><label>ID Evento</label><input type="text" class="control" id="filtroEvento" placeholder="ID do evento"></div>
    <div class="field"><label>Ação</label>
      <select class="control" id="filtroAcao" data-label="Ação">
        <option value="">Todas</option>
        <option value="envio">Envio</option>
        <option value="retorno">Retorno</option>
        <option value="fixo">Fixo</option>
      </select>
    </div>
  </div>

  <!-- TABELA (uma só: .table-scroll = scroll interno 68vh + thead sticky) -->
  <div class="table-scroll">
    <table class="tbl">
      <thead>
        <tr>
          <th>Nº Serial</th>
          <th>ID Evento</th>
          <th>Ação</th>
          <th>Data Envio</th>
          <th>Data Retorno</th>
          <th>Usuário</th>
          <th>Nome Evento</th>
          <th>Produtora</th>
          <th>Comercial</th>
          <th>Observação</th>
        </tr>
      </thead>
      <tbody id="bodyHistorico">

        <% if (!historico || historico.length === 0) { %>
          <tr><td colspan="10" class="empty">Nenhum registro encontrado</td></tr>
        <% } else { %>
          <% [...historico].reverse().forEach(h => { %>
            <tr class="linha">
              <td class="c-serial" data-label="Serial"><%= h.serial || "-" %></td>
              <td data-label="ID Evento"><%= h.evento || "-" %></td>
              <td data-label="Ação"><%= h.acao || "-" %></td>
              <td data-label="Data Envio"><%= h.saida || "-" %></td>
              <td data-label="Data Retorno"><%= h.retorno || "-" %></td>
              <td data-label="Usuário"><%= h.usuario || "-" %></td>
              <td class="nome-cell" data-label="Nome Evento"><span title="<%= (h.nome_evento && h.nome_evento !== '-') ? h.nome_evento : '' %>"><%= h.nome_evento || "-" %></span></td>
              <td class="prod-cell" data-label="Produtora"><span title="<%= (h.produtora && h.produtora !== '-') ? h.produtora : '' %>"><%= h.produtora || "-" %></span></td>
              <td class="com-cell" data-label="Comercial"><span title="<%= (h.comercial && h.comercial !== '-') ? h.comercial : '' %>"><%= h.comercial || "-" %></span></td>
              <td class="obs-cell" data-label="Observação"><span title="<%= (h.obs && h.obs !== '-') ? h.obs : '' %>"><%= h.obs || "-" %></span></td>
            </tr>
          <% }) %>
        <% } %>

      </tbody>
    </table>
  </div>
</div>

<%- include('partials/footer') %>

<script>
const filtroSerial = document.getElementById("filtroSerial");
const filtroEvento = document.getElementById("filtroEvento");
const filtroAcao   = document.getElementById("filtroAcao");

const tabela = document.getElementById("bodyHistorico");

/* =====================================================
   SUPORTE A MÚLTIPLOS SERIAIS E EVENTOS
===================================================== */
function parseLista(value) {
  return value
    .toLowerCase()
    .replace(/\s+/g, "")
    .split(/[,;\n]+/g)
    .filter(x => x !== "");
}

function aplicarFiltros() {
  const listaSeriais = parseLista(filtroSerial.value);
  const listaEventos = parseLista(filtroEvento.value);
  const acaoFiltro   = filtroAcao.value.toLowerCase();

  for (const row of tabela.rows) {
    let show = true;

    const colSerial = row.cells[0].innerText.toLowerCase().replace(/\s+/g, "");
    const colEvento = row.cells[1].innerText.toLowerCase().replace(/\s+/g, "");
    const colAcao   = row.cells[2].innerText.toLowerCase();

    if (listaSeriais.length > 0 && !listaSeriais.some(v => colSerial.includes(v)))
      show = false;

    if (listaEventos.length > 0 && !listaEventos.some(v => colEvento.includes(v)))
      show = false;

    if (acaoFiltro && !colAcao.includes(acaoFiltro))
      show = false;

    row.style.display = show ? "" : "none";
  }
}

filtroSerial.addEventListener("input", aplicarFiltros);
filtroEvento.addEventListener("input", aplicarFiltros);
filtroAcao.addEventListener("change", aplicarFiltros);
</script>
